---
import RegistryLayout from "../layouts/RegistryLayout.astro";
import { packageHref, registryPackages } from "../lib/registry";
import { defaultLocale, translations } from "../i18n/translations";
import { ArrowRight, Search } from "lucide-astro";

const t = translations[defaultLocale];
const apiOrigin = (import.meta.env.PUBLIC_REGISTRY_API_ORIGIN || "https://api.registry.cellscript.dev").replace(/\/$/, "");
const fallbackPackages = registryPackages.map((pkg) => ({
  coordinate: pkg.coordinate,
  namespace: pkg.namespace,
  name: pkg.name,
  latest_version: pkg.latest_version || null,
  status: pkg.status,
  description: pkg.description || null,
  repository: pkg.repository || null,
  keywords: pkg.keywords || [],
  categories: pkg.categories || [],
  versions: pkg.versions,
  href: packageHref(pkg),
  source: "bundled",
}));
---

<RegistryLayout
  title="CellScript Registry"
  description={t.registry.browse.description}
  headingKey="registry.browse.title"
  descriptionKey="registry.browse.description"
  active="search"
>
  <section class="registry-browse" data-registry-browser data-api-origin={apiOrigin} aria-label={t.registry.browse.searchAria}>
    <div class="registry-browse-search">
      <label class="registry-browse-input">
        <Search aria-hidden="true" />
        <span class="sr-only" data-i18n="registry.browse.searchAria">{t.registry.browse.searchAria}</span>
        <input
          type="search"
          autocomplete="off"
          placeholder={t.registry.browse.searchPlaceholder}
          data-i18n-placeholder="registry.browse.searchPlaceholder"
          data-registry-query
        />
      </label>
      <span class="registry-browse-count" data-registry-count aria-live="polite"></span>
    </div>

    <div class="registry-service-state" data-registry-service-state data-state="loading" role="status" aria-live="polite">
      <span class="registry-service-dot" aria-hidden="true"></span>
      <span data-registry-service-copy data-i18n="registry.browse.loading">{t.registry.browse.loading}</span>
      <a href={`${apiOrigin}/health`} target="_blank" rel="noopener noreferrer">API</a>
    </div>

    <div class="registry-package-list" data-registry-list>
      {fallbackPackages.map((pkg) => (
        <a
          class="registry-package-row"
          href={pkg.href}
          data-registry-row
          data-registry-search={`${pkg.coordinate} ${pkg.description || ""} ${pkg.latest_version || ""} ${pkg.status} ${pkg.keywords.join(" ")} ${pkg.categories.join(" ")}`.toLowerCase()}
        >
          <div>
            <strong>{pkg.coordinate}</strong>
            <p>{pkg.description || t.registry.browse.noDescription}</p>
            <div class="registry-badges">
              <span class="registry-badge">{pkg.latest_version || t.registry.browse.unversioned}</span>
              <span class="registry-badge">{pkg.status}</span>
              <span class="registry-badge">Edition {pkg.versions[0]?.edition || "2026"}</span>
            </div>
          </div>
          <ArrowRight class="registry-row-arrow" aria-hidden="true" />
        </a>
      ))}
    </div>

    <div class="registry-empty" data-registry-empty hidden>
      <h2 data-registry-empty-title>{t.registry.browse.emptyTitle}</h2>
      <p data-registry-empty-body>{t.registry.browse.emptyBody}</p>
      <a class="registry-button primary" href="/registry/submit" data-i18n="registry.submitPackage">{t.registry.submitPackage}</a>
    </div>
  </section>

  <script is:inline define:vars={{ fallbackPackages }}>
    (() => {
      const prior = window.__cellscriptRegistryBrowseAbort;
      prior?.abort();
      const controller = new AbortController();
      window.__cellscriptRegistryBrowseAbort = controller;
      const { signal } = controller;
      document.addEventListener("astro:before-swap", () => controller.abort(), { once: true, signal });

      const app = document.querySelector("[data-registry-browser]");
      if (!app) return;
      const list = app.querySelector("[data-registry-list]");
      const query = app.querySelector("[data-registry-query]");
      const count = app.querySelector("[data-registry-count]");
      const empty = app.querySelector("[data-registry-empty]");
      const emptyTitle = app.querySelector("[data-registry-empty-title]");
      const emptyBody = app.querySelector("[data-registry-empty-body]");
      const service = app.querySelector("[data-registry-service-state]");
      const serviceCopy = app.querySelector("[data-registry-service-copy]");
      const apiOrigin = app.dataset.apiOrigin;
      let packages = fallbackPackages;
      let source = "loading";

      const messages = () => window.__CELLSCRIPT_I18N__;
      const locale = () => document.documentElement.dataset.locale === "zh" ? "zh" : "en";
      const message = (path) => path.split(".").reduce((value, key) => value?.[key], messages()?.[locale()]);
      const format = (template, values) => Object.entries(values).reduce((value, [key, replacement]) => value.replaceAll(`{${key}}`, String(replacement)), template || "");

      const detailHref = (pkg) => {
        if (pkg.source === "bundled" && pkg.href) return pkg.href;
        const params = new URLSearchParams({ namespace: pkg.namespace, name: pkg.name });
        return `/registry/package/?${params}`;
      };

      const renderRows = () => {
        if (!list) return;
        list.replaceChildren();
        for (const pkg of packages) {
          const row = document.createElement("a");
          row.className = "registry-package-row";
          row.href = detailHref(pkg);
          row.dataset.registryRow = "";
          row.dataset.registrySearch = [pkg.coordinate, pkg.description, pkg.latest_version, pkg.status, ...(pkg.keywords || []), ...(pkg.categories || [])]
            .filter(Boolean).join(" ").toLowerCase();

          const body = document.createElement("div");
          const title = document.createElement("strong");
          title.textContent = pkg.coordinate;
          const description = document.createElement("p");
          description.textContent = pkg.description || message("registry.browse.noDescription") || "No package description recorded.";
          const badges = document.createElement("div");
          badges.className = "registry-badges";
          const version = document.createElement("span");
          version.className = "registry-badge";
          version.textContent = pkg.latest_version || message("registry.browse.unversioned") || "unversioned";
          const status = document.createElement("span");
          status.className = "registry-badge";
          status.textContent = pkg.status || "source_published";
          const edition = document.createElement("span");
          edition.className = "registry-badge";
          edition.textContent = `Edition ${pkg.versions?.[0]?.edition || "2026"}`;
          badges.append(version, status, edition);
          body.append(title, description, badges);

          const arrow = document.createElement("span");
          arrow.className = "registry-row-arrow";
          arrow.setAttribute("aria-hidden", "true");
          arrow.textContent = "→";
          row.append(body, arrow);
          list.append(row);
        }
        applyFilter();
      };

      const applyFilter = () => {
        const needle = query?.value.trim().toLowerCase() || "";
        const rows = Array.from(list?.querySelectorAll("[data-registry-row]") || []);
        let visible = 0;
        for (const row of rows) {
          const matches = !needle || (row.dataset.registrySearch || "").includes(needle);
          row.hidden = !matches;
          if (matches) visible += 1;
        }
        const countKey = visible === 1 ? "registry.browse.countOne" : "registry.browse.countMany";
        if (count) count.textContent = format(message(countKey), { n: visible });
        if (empty) empty.hidden = visible !== 0;
        if (emptyTitle) emptyTitle.textContent = message(needle ? "registry.browse.noMatchTitle" : "registry.browse.emptyTitle") || "";
        if (emptyBody) emptyBody.textContent = message(needle ? "registry.browse.noMatchBody" : "registry.browse.emptyBody") || "";
      };

      const setServiceState = (next) => {
        source = next;
        if (service) service.dataset.state = next;
        if (serviceCopy) {
          const key = next === "live" ? "registry.browse.liveStatus" : next === "mirror" ? "registry.browse.mirrorStatus" : "registry.browse.loading";
          serviceCopy.textContent = message(key) || "";
          serviceCopy.dataset.i18n = key;
        }
      };

      query?.addEventListener("input", applyFilter, { signal });
      window.addEventListener("cellscript:locale-change", () => {
        renderRows();
        setServiceState(source);
      }, { signal });

      renderRows();
      setServiceState("loading");
      fetch(`${apiOrigin}/v1/packages?limit=100`, { headers: { accept: "application/json" }, signal })
        .then(async (response) => {
          if (!response.ok) throw new Error(`registry API returned ${response.status}`);
          const payload = await response.json();
          if (payload?.schema !== "cellscript-public-registry-index-v1" || !Array.isArray(payload.packages)) {
            throw new Error("registry API returned an unsupported schema");
          }
          packages = payload.packages.map((pkg) => ({ ...pkg, source: "live" }));
          setServiceState("live");
          renderRows();
        })
        .catch((error) => {
          if (error?.name === "AbortError") return;
          packages = fallbackPackages;
          setServiceState("mirror");
          renderRows();
        });
    })();
  </script>
</RegistryLayout>
