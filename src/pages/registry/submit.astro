---
import RegistryLayout from "../../layouts/RegistryLayout.astro";
import { defaultLocale, translations } from "../../i18n/translations";

const t = translations[defaultLocale];
const description = t.registry.submit.description;
const apiOrigin = (import.meta.env.PUBLIC_REGISTRY_API_ORIGIN || "https://api.registry.cellscript.dev").replace(/\/$/, "");
---

<RegistryLayout title="CellScript Registry: Submit" description={description} headingKey="registry.submit.title" descriptionKey="registry.submit.description" active="submit" showSubmitCta={false}>
  <section class="registry-flow" aria-label={t.registry.nav.submit} data-i18n-aria-label="registry.nav.submit">
    <div class="registry-flow-head">
      <p class="registry-label" data-i18n="registry.submit.builderLabel">{t.registry.submit.builderLabel}</p>
      <h2 data-i18n="registry.submit.builderHeading">{t.registry.submit.builderHeading}</h2>
      <p data-i18n="registry.submit.builderBody">{t.registry.submit.builderBody}</p>
    </div>

    <form class="registry-builder" data-submit-form novalidate>
      <div class="registry-builder-grid registry-builder-grid-compact">
        <label class="registry-builder-field">
          <span data-i18n="registry.submit.namespace">{t.registry.submit.namespace}</span>
          <input
            class="registry-input"
            name="namespace"
            placeholder="dob"
            autocomplete="off"
            required
            minlength="2"
            maxlength="63"
            pattern="[a-z0-9][a-z0-9_-]{1,62}"
            aria-describedby="submit-coordinate-help submit-coordinate-error"
          />
        </label>
        <label class="registry-builder-field">
          <span data-i18n="registry.submit.packageName">{t.registry.submit.packageName}</span>
          <input
            class="registry-input"
            name="name"
            placeholder="evolving-dob-profile-v1"
            autocomplete="off"
            required
            minlength="2"
            maxlength="63"
            pattern="[a-z0-9][a-z0-9_-]{1,62}"
            aria-describedby="submit-coordinate-help submit-coordinate-error"
          />
        </label>
        <label class="registry-builder-field">
          <span data-i18n="registry.submit.packageDir">{t.registry.submit.packageDir}</span>
          <input class="registry-input" name="path" placeholder="./path/to/package" autocomplete="off" />
        </label>
      </div>
      <p class="registry-field-hint" id="submit-coordinate-help" data-i18n="registry.submit.coordinateHelp">{t.registry.submit.coordinateHelp}</p>
      <p class="registry-field-error" id="submit-coordinate-error" data-coordinate-error hidden data-i18n="registry.submit.invalidCoordinate">{t.registry.submit.invalidCoordinate}</p>
    </form>

    <ol class="registry-steps">
      <li class="registry-step-card">
        <div class="registry-step-copy">
          <span class="registry-step-num">01</span>
          <h3 data-i18n="registry.submit.preflightTitle">{t.registry.submit.preflightTitle}</h3>
          <p data-i18n="registry.submit.preflightBody">{t.registry.submit.preflightBody}</p>
        </div>
        <div class="registry-step-code">
          <code data-submit-preflight>cellc package verify --json &amp;&amp; cellc publish --dry-run</code>
          <button class="registry-copy" type="button" data-submit-preflight-copy data-copy-text="cellc package verify --json && cellc publish --dry-run" data-revert-label={t.registry.copy} data-i18n="registry.copy">{t.registry.copy}</button>
        </div>
      </li>

      <li class="registry-step-card registry-step-card-capability">
        <div class="registry-step-copy">
          <span class="registry-step-num">02</span>
          <h3 data-i18n="registry.submit.discoveryTitle">{t.registry.submit.discoveryTitle}</h3>
          <p data-i18n="registry.submit.discoveryBody">{t.registry.submit.discoveryBody}</p>
        </div>

        <section
          class="registry-signer"
          data-capability-signer
          data-api-origin={apiOrigin}
          aria-labelledby="registry-wallet-heading"
        >
          <div class="registry-wallet-head">
            <div>
              <p class="registry-label" data-i18n="registry.submit.walletLabel">{t.registry.submit.walletLabel}</p>
              <h4 id="registry-wallet-heading" data-i18n="registry.submit.walletTitle">{t.registry.submit.walletTitle}</h4>
              <p data-i18n="registry.submit.walletBody">{t.registry.submit.walletBody}</p>
            </div>
            <label class="registry-builder-field registry-network-field">
              <span data-i18n="registry.submit.network">{t.registry.submit.network}</span>
              <select class="registry-select" data-capability-network>
                <option value="mainnet" data-i18n="registry.submit.mainnet">{t.registry.submit.mainnet}</option>
                <option value="testnet" data-i18n="registry.submit.testnet">{t.registry.submit.testnet}</option>
              </select>
            </label>
          </div>

          <div class="registry-wallet-boundary" role="note">
            <strong data-i18n="registry.submit.boundaryTitle">{t.registry.submit.boundaryTitle}</strong>
            <span data-i18n="registry.submit.boundaryBody">{t.registry.submit.boundaryBody}</span>
          </div>

          <ol class="registry-authorisation-progress" aria-label={t.registry.submit.progressLabel} data-i18n-aria-label="registry.submit.progressLabel">
            <li data-workflow-stage="wallet"><span>1</span><strong data-i18n="registry.submit.stageWallet">{t.registry.submit.stageWallet}</strong></li>
            <li data-workflow-stage="payload"><span>2</span><strong data-i18n="registry.submit.stagePayload">{t.registry.submit.stagePayload}</strong></li>
            <li data-workflow-stage="signature"><span>3</span><strong data-i18n="registry.submit.stageSignature">{t.registry.submit.stageSignature}</strong></li>
            <li data-workflow-stage="capability"><span>4</span><strong data-i18n="registry.submit.stageCapability">{t.registry.submit.stageCapability}</strong></li>
            <li data-workflow-stage="namespace"><span>5</span><strong data-i18n="registry.submit.stageNamespace">{t.registry.submit.stageNamespace}</strong></li>
          </ol>

          <label class="registry-builder-field registry-signer-principal" data-principal-panel hidden>
            <span data-i18n="registry.submit.principal">{t.registry.submit.principal}</span>
            <span class="registry-inline-control">
              <input
                class="registry-input"
                data-capability-principal
                readonly
                placeholder={t.registry.submit.principalPlaceholder}
                data-i18n-placeholder="registry.submit.principalPlaceholder"
              />
              <button class="registry-copy" type="button" data-capability-copy-principal data-copy-text="" data-revert-label={t.registry.submit.copyPrincipal} data-i18n="registry.submit.copyPrincipal">{t.registry.submit.copyPrincipal}</button>
            </span>
          </label>

          <div class="registry-progressive-panel" data-payload-panel hidden>
            <label class="registry-builder-field">
              <span data-i18n="registry.submit.payload">{t.registry.submit.payload}</span>
              <textarea
                class="registry-textarea"
                data-capability-payload
                spellcheck="false"
                placeholder={t.registry.submit.payloadPlaceholder}
                data-i18n-placeholder="registry.submit.payloadPlaceholder"
                aria-describedby="capability-payload-hint"
              ></textarea>
              <small class="registry-field-hint" id="capability-payload-hint" data-i18n="registry.submit.payloadHint">{t.registry.submit.payloadHint}</small>
            </label>
          </div>

          <div class="registry-progressive-panel" data-signature-panel hidden>
            <label class="registry-builder-field">
              <span data-i18n="registry.submit.signature">{t.registry.submit.signature}</span>
              <textarea class="registry-textarea" data-capability-signature spellcheck="false" readonly></textarea>
              <small class="registry-field-hint" data-i18n="registry.submit.signatureReady">{t.registry.submit.signatureReady}</small>
            </label>
            <button class="registry-copy" type="button" data-capability-copy-signature data-copy-text="" data-revert-label={t.registry.submit.copySignature} data-i18n="registry.submit.copySignature">{t.registry.submit.copySignature}</button>
          </div>

          <div class="registry-signer-actions">
            <button class="registry-button primary registry-workflow-primary" type="button" data-capability-primary disabled data-i18n="registry.submit.continueConnect">{t.registry.submit.continueConnect}</button>
            <button class="registry-button" type="button" data-capability-change-wallet hidden data-i18n="registry.submit.changeWallet">{t.registry.submit.changeWallet}</button>
          </div>
          <output class="registry-signer-status" data-capability-status role="status" aria-live="polite" data-i18n="registry.submit.walletIdle">{t.registry.submit.walletIdle}</output>
          <details class="registry-technical-details" data-capability-details hidden>
            <summary data-i18n="registry.submit.technicalDetails">{t.registry.submit.technicalDetails}</summary>
            <pre class="registry-signer-response" data-capability-response></pre>
          </details>
        </section>

        <div class="registry-step-code registry-capability-command">
          <code data-submit-add>cellc auth capability create --principal-type &lt;principal_type&gt; --principal-id &lt;principal_id&gt; --scope publish:&lt;namespace&gt;/&lt;name&gt; --expires 90d --json &gt; capability-payload.json
cellc auth capability submit --payload capability-payload.json --wallet-signature wallet-signature.json
cellc auth namespace claim --namespace &lt;namespace&gt; --payload capability-payload.json --wallet-signature wallet-signature.json</code>
          <button class="registry-copy" type="button" data-submit-copy data-copy-text="" data-revert-label={t.registry.submit.copyAddCommand} data-i18n="registry.submit.copyAddCommand">{t.registry.submit.copyAddCommand}</button>
        </div>
      </li>

      <li class="registry-step-card registry-publish-step" data-publish-step data-state="locked">
        <div class="registry-step-copy">
          <span class="registry-step-num">03</span>
          <h3 data-i18n="registry.submit.prTitle">{t.registry.submit.prTitle}</h3>
          <p data-i18n="registry.submit.prBody">{t.registry.submit.prBody}</p>
          <p class="registry-publish-lock" data-publish-lock data-i18n="registry.submit.publishLocked">{t.registry.submit.publishLocked}</p>
          <button class="registry-text-button" type="button" data-existing-capability data-i18n="registry.submit.alreadyAuthorised">{t.registry.submit.alreadyAuthorised}</button>
        </div>
        <div class="registry-step-code">
          <code data-submit-publish>cellc publish</code>
          <button class="registry-copy" type="button" data-submit-publish-copy data-copy-text="cellc publish" data-revert-label={t.registry.copy} data-i18n="registry.copy" disabled>{t.registry.copy}</button>
        </div>
      </li>
    </ol>
  </section>

  <script>
    import { applyCCCConnectorTheme } from "../../lib/cccConnectorTheme";

    type PrincipalType = "joyid_ckb" | "ckb_secp256k1";
    type WalletIdentity = {
      principalType: PrincipalType;
      publicKey: string;
      keyType?: "main_key" | "sub_key";
    };
    type WalletSignature = Record<string, unknown> & {
      challenge: string;
      signature: string;
    };

    class WorkflowError extends Error {
      constructor(readonly key: string, technical?: string) {
        super(technical || key);
      }
    }

    const lifecycle = new AbortController();
    const { signal } = lifecycle;
    const form = document.querySelector<HTMLFormElement>("[data-submit-form]");
    const namespaceInput = form?.elements.namedItem("namespace") as HTMLInputElement | null;
    const nameInput = form?.elements.namedItem("name") as HTMLInputElement | null;
    const coordinateError = document.querySelector<HTMLElement>("[data-coordinate-error]");
    const preflight = document.querySelector<HTMLElement>("[data-submit-preflight]");
    const preflightCopy = document.querySelector<HTMLButtonElement>("[data-submit-preflight-copy]");
    const capabilityCommand = document.querySelector<HTMLElement>("[data-submit-add]");
    const capabilityCopy = document.querySelector<HTMLButtonElement>("[data-submit-copy]");
    const publish = document.querySelector<HTMLElement>("[data-submit-publish]");
    const publishCopy = document.querySelector<HTMLButtonElement>("[data-submit-publish-copy]");
    const publishStep = document.querySelector<HTMLElement>("[data-publish-step]");
    const publishLock = document.querySelector<HTMLElement>("[data-publish-lock]");
    const existingCapability = document.querySelector<HTMLButtonElement>("[data-existing-capability]");
    const signerRoot = document.querySelector<HTMLElement>("[data-capability-signer]");
    const networkSelect = document.querySelector<HTMLSelectElement>("[data-capability-network]");
    const principalPanel = document.querySelector<HTMLElement>("[data-principal-panel]");
    const principalInput = document.querySelector<HTMLInputElement>("[data-capability-principal]");
    const payloadPanel = document.querySelector<HTMLElement>("[data-payload-panel]");
    const payloadInput = document.querySelector<HTMLTextAreaElement>("[data-capability-payload]");
    const signaturePanel = document.querySelector<HTMLElement>("[data-signature-panel]");
    const signatureOutput = document.querySelector<HTMLTextAreaElement>("[data-capability-signature]");
    const primaryButton = document.querySelector<HTMLButtonElement>("[data-capability-primary]");
    const changeWalletButton = document.querySelector<HTMLButtonElement>("[data-capability-change-wallet]");
    const copyPrincipalButton = document.querySelector<HTMLButtonElement>("[data-capability-copy-principal]");
    const copySignatureButton = document.querySelector<HTMLButtonElement>("[data-capability-copy-signature]");
    const statusOutput = document.querySelector<HTMLOutputElement>("[data-capability-status]");
    const technicalDetails = document.querySelector<HTMLDetailsElement>("[data-capability-details]");
    const technicalOutput = document.querySelector<HTMLElement>("[data-capability-response]");
    const stages = Array.from(document.querySelectorAll<HTMLElement>("[data-workflow-stage]"));
    const appLogo = `${window.location.origin}${import.meta.env.BASE_URL}cellscript-logo.png`;
    const walletStorageKey = "cellscript-registry-wallet-connection";
    const joyidPrincipalContext = "cellscript-registry-joyid-ckb-principal-v1";
    const ckbPrincipalContext = "cellscript-registry-ckb-secp256k1-principal-v1";
    const coordinatePattern = /^[a-z0-9][a-z0-9_-]{1,62}$/;

    let cccPromise: Promise<typeof import("@ckb-ccc/connector")> | null = null;
    let activeWalletSigner: any | null = null;
    let activeWalletIdentity: WalletIdentity | null = null;
    let activeConnector: HTMLElement | null = null;
    let capabilitySubmitted = false;
    let namespaceClaimed = false;
    let authorisedOverride = false;
    let busy = false;
    let statusKey = "walletIdle";
    let statusTone: "idle" | "ok" | "error" = "idle";
    let statusSuffix = "";
    let lastCoordinate = "";

    const message = (key: string): string => {
      const locale = document.documentElement.dataset.locale === "zh" ? "zh" : "en";
      const messages = (window as any).__CELLSCRIPT_I18N__?.[locale]?.registry?.submit;
      return typeof messages?.[key] === "string" ? messages[key] : key;
    };
    const setStatus = (key: string, tone: "idle" | "ok" | "error" = "idle", suffix = "") => {
      statusKey = key;
      statusTone = tone;
      statusSuffix = suffix;
      if (statusOutput) {
        statusOutput.dataset.tone = tone;
        statusOutput.textContent = `${message(key)}${suffix}`;
        statusOutput.removeAttribute("data-i18n");
      }
    };
    const showTechnical = (value: unknown) => {
      if (!technicalDetails || !technicalOutput) return;
      technicalDetails.hidden = false;
      technicalOutput.textContent = typeof value === "string" ? value : JSON.stringify(value, null, 2);
    };
    const clearTechnical = () => {
      if (technicalDetails) {
        technicalDetails.hidden = true;
        technicalDetails.open = false;
      }
      if (technicalOutput) technicalOutput.textContent = "";
    };
    const setError = (error: unknown, fallbackKey: string) => {
      const key = error instanceof WorkflowError ? error.key : fallbackKey;
      setStatus(key, "error");
      if (error instanceof WorkflowError) {
        if (error.message !== error.key) showTechnical(error.message);
      } else if (error instanceof Error) showTechnical(error.message);
      else if (error != null) showTechnical(error);
    };
    const fieldValue = (name: string) => {
      const input = form?.elements.namedItem(name);
      return input instanceof HTMLInputElement ? input.value.trim() : "";
    };
    const coordinateValid = () => coordinatePattern.test(fieldValue("namespace")) && coordinatePattern.test(fieldValue("name"));
    const shellQuote = (text: string) => /[\s"'$]/.test(text) ? `'${text.replace(/'/g, "'\\''")}'` : text;
    const commandPrefix = () => fieldValue("path") ? `cd ${shellQuote(fieldValue("path"))} && ` : "";

    const sortJson = (value: unknown): unknown => {
      if (Array.isArray(value)) return value.map(sortJson);
      if (value && typeof value === "object") {
        const output: Record<string, unknown> = {};
        for (const key of Object.keys(value as Record<string, unknown>).sort()) {
          const item = (value as Record<string, unknown>)[key];
          if (item !== undefined) output[key] = sortJson(item);
        }
        return output;
      }
      return value;
    };
    const canonicalJson = (value: unknown): string => JSON.stringify(sortJson(value));
    const sha256Hex = async (value: string): Promise<string> => {
      const hash = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
      return Array.from(new Uint8Array(hash), (byte) => byte.toString(16).padStart(2, "0")).join("");
    };
    const normalizePubkey = (value: string): string => {
      const trimmed = value.trim().toLowerCase();
      return trimmed.startsWith("0x") ? trimmed.slice(2) : trimmed;
    };
    const joyidPrincipalId = async (keyType: string, publicKey: string): Promise<string> =>
      `0x${await sha256Hex(`${joyidPrincipalContext}\n${keyType}\n${normalizePubkey(publicKey)}`)}`;
    const ckbPrincipalId = async (publicKey: string): Promise<string> => {
      const normalized = `0x${normalizePubkey(publicKey)}`;
      return `0x${await sha256Hex(`${ckbPrincipalContext}\n${normalized}`)}`;
    };

    const parsePayload = (): Record<string, unknown> => {
      if (!payloadInput?.value.trim()) throw new WorkflowError("errorPayloadRequired");
      let parsed: unknown;
      try {
        parsed = JSON.parse(payloadInput.value);
      } catch (error) {
        throw new WorkflowError("errorPayloadObject", error instanceof Error ? error.message : undefined);
      }
      const payload = parsed && typeof parsed === "object" && !Array.isArray(parsed) && "payload" in parsed
        ? (parsed as Record<string, unknown>).payload
        : parsed;
      if (!payload || typeof payload !== "object" || Array.isArray(payload)) throw new WorkflowError("errorPayloadObject");
      return payload as Record<string, unknown>;
    };
    const hasValidPayload = () => {
      try {
        parsePayload();
        return true;
      } catch {
        return false;
      }
    };

    const updateCommands = () => {
      const namespace = fieldValue("namespace") || "<namespace>";
      const name = fieldValue("name") || "<name>";
      const principalId = principalInput?.value.trim() || "<principal_id>";
      const principalType = principalInput?.dataset.principalType || "<principal_type>";
      const preflightCommand = `${commandPrefix()}cellc package verify --json && cellc publish --dry-run`;
      const authCommand = `cellc auth capability create --principal-type ${shellQuote(principalType)} --principal-id ${shellQuote(principalId)} --scope ${shellQuote(`publish:${namespace}/${name}`)} --expires 90d --json > capability-payload.json\ncellc auth capability submit --payload capability-payload.json --wallet-signature wallet-signature.json\ncellc auth namespace claim --namespace ${shellQuote(namespace)} --payload capability-payload.json --wallet-signature wallet-signature.json`;
      const publishCommand = `${commandPrefix()}cellc publish`;
      if (preflight) preflight.textContent = preflightCommand;
      if (preflightCopy) preflightCopy.dataset.copyText = preflightCommand;
      if (capabilityCommand) capabilityCommand.textContent = authCommand;
      if (capabilityCopy) capabilityCopy.dataset.copyText = authCommand;
      if (publish) publish.textContent = publishCommand;
      if (publishCopy) publishCopy.dataset.copyText = namespaceClaimed || authorisedOverride ? publishCommand : "";
    };

    const stageState = (name: string, complete: boolean, active: boolean) => {
      const stage = stages.find((item) => item.dataset.workflowStage === name);
      if (stage) stage.dataset.state = complete ? "complete" : active ? "active" : "pending";
    };
    const syncWorkflow = () => {
      const walletReady = Boolean(activeWalletSigner && activeWalletIdentity);
      const payloadReady = walletReady && hasValidPayload();
      const signatureReady = payloadReady && Boolean(signatureOutput?.value.trim());
      stageState("wallet", walletReady, !walletReady);
      stageState("payload", payloadReady, walletReady && !payloadReady);
      stageState("signature", signatureReady, payloadReady && !signatureReady);
      stageState("capability", capabilitySubmitted, signatureReady && !capabilitySubmitted);
      stageState("namespace", namespaceClaimed, capabilitySubmitted && !namespaceClaimed);
      if (principalPanel) principalPanel.hidden = !walletReady;
      if (payloadPanel) payloadPanel.hidden = !walletReady;
      if (signaturePanel) signaturePanel.hidden = !signatureReady;
      if (changeWalletButton) changeWalletButton.hidden = !walletReady;
      const canPublish = namespaceClaimed || authorisedOverride;
      if (publishStep) publishStep.dataset.state = canPublish ? "ready" : "locked";
      if (publishLock) publishLock.hidden = canPublish;
      if (existingCapability) existingCapability.hidden = canPublish;
      if (publishCopy) publishCopy.disabled = !canPublish;

      let primaryKey = "continueConnect";
      if (walletReady && !payloadReady) primaryKey = "continuePayload";
      else if (payloadReady && !signatureReady) primaryKey = "continueSign";
      else if (signatureReady && !capabilitySubmitted) primaryKey = "continueSubmit";
      else if (capabilitySubmitted && !namespaceClaimed) primaryKey = "continueClaim";
      else if (namespaceClaimed) primaryKey = "continueDone";
      if (primaryButton) {
        primaryButton.dataset.i18n = `registry.submit.${primaryKey}`;
        primaryButton.textContent = message(primaryKey);
        primaryButton.disabled = busy || !coordinateValid() || namespaceClaimed;
        primaryButton.setAttribute("aria-busy", String(busy));
      }
      const valid = coordinateValid();
      for (const input of [namespaceInput, nameInput]) {
        if (input) input.setAttribute("aria-invalid", String(input.value.length > 0 && !coordinatePattern.test(input.value.trim())));
      }
      if (coordinateError) coordinateError.hidden = valid || (!namespaceInput?.value && !nameInput?.value);
      updateCommands();
    };

    const loadCCC = async () => {
      cccPromise ??= import("@ckb-ccc/connector");
      return cccPromise;
    };
    const createCkbOnlyController = (ccc: typeof import("@ckb-ccc/connector").ccc) => new class extends ccc.SignersController {
      private readonly ckbWallets = new Map<string, any>();
      async refresh(client: any, onUpdate: (wallets: any[]) => void, configs?: any) {
        await super.refresh(client, (wallets: any[]) => {
          for (const wallet of wallets) {
            const signers = wallet.signers.filter((info: any) => info.signer?.type === ccc.SignerType.CKB);
            if (signers.length > 0) this.ckbWallets.set(wallet.name, { ...wallet, signers });
          }
          onUpdate([...this.ckbWallets.values()]);
        }, configs);
      }
    }();

    const readSignerIdentity = async (signer: any): Promise<WalletIdentity> => {
      const raw = typeof signer.getIdentity === "function" ? await signer.getIdentity() : undefined;
      if (typeof raw !== "string" || !raw.trim()) throw new WorkflowError("errorPublicKey");
      try {
        const parsed = JSON.parse(raw) as Record<string, unknown>;
        const publicKey = typeof parsed.publicKey === "string" ? parsed.publicKey : "";
        const keyType = parsed.keyType;
        if (publicKey && (keyType === "main_key" || keyType === "sub_key")) return { principalType: "joyid_ckb", publicKey, keyType };
        if (/^(?:0x)?(?:02|03)[0-9a-fA-F]{64}$/.test(publicKey)) return { principalType: "ckb_secp256k1", publicKey: `0x${normalizePubkey(publicKey)}` };
      } catch {
        // Standard CKB signers expose the compressed public key directly.
      }
      if (/^(?:0x)?(?:02|03)[0-9a-fA-F]{64}$/.test(raw.trim())) return { principalType: "ckb_secp256k1", publicKey: `0x${normalizePubkey(raw)}` };
      throw new WorkflowError("errorUnsupportedIdentity");
    };
    const readSignerAddress = async (signer: any): Promise<string | undefined> => {
      try {
        return typeof signer.getInternalAddress === "function" ? await signer.getInternalAddress() : undefined;
      } catch {
        return undefined;
      }
    };
    const openWalletConnector = async (): Promise<any> => {
      const { ccc } = await loadCCC();
      const network = networkSelect?.value === "testnet" ? "testnet" : "mainnet";
      const connector = document.createElement("ccc-connector") as any;
      connector.name = "CellScript Registry";
      connector.icon = appLogo;
      connector.client = network === "testnet" ? new ccc.ClientPublicTestnet() : new ccc.ClientPublicMainnet();
      connector.preferredNetworks = [{ addressPrefix: network === "testnet" ? "ckt" : "ckb", signerType: ccc.SignerType.CKB, network }];
      connector.signersController = createCkbOnlyController(ccc);
      activeConnector = connector;
      applyCCCConnectorTheme(connector);
      return new Promise((resolve, reject) => {
        const timeout = window.setTimeout(() => {
          connector.remove();
          if (activeConnector === connector) activeConnector = null;
          reject(new WorkflowError("errorWallet", "Wallet connection timed out"));
        }, 180000);
        connector.addEventListener("close", async () => {
          window.clearTimeout(timeout);
          try {
            const signer = connector.signer?.signer;
            if (!signer || (typeof signer.isConnected === "function" && !(await signer.isConnected()))) throw new WorkflowError("errorNoWallet");
            resolve(signer);
          } catch (error) {
            reject(error);
          } finally {
            connector.remove();
            if (activeConnector === connector) activeConnector = null;
          }
        }, { once: true });
        document.body.appendChild(connector);
        applyCCCConnectorTheme(connector);
      });
    };

    const clearSignature = () => {
      if (signatureOutput) signatureOutput.value = "";
      if (copySignatureButton) copySignatureButton.dataset.copyText = "";
      capabilitySubmitted = false;
      namespaceClaimed = false;
    };
    const resetWallet = async (disconnect = false) => {
      if (disconnect && typeof activeWalletSigner?.disconnect === "function") {
        try { await activeWalletSigner.disconnect(); } catch { /* Wallet may already be closed. */ }
      }
      activeWalletSigner = null;
      activeWalletIdentity = null;
      if (principalInput) {
        principalInput.value = "";
        delete principalInput.dataset.principalType;
      }
      if (copyPrincipalButton) copyPrincipalButton.dataset.copyText = "";
      clearSignature();
      localStorage.removeItem(walletStorageKey);
      clearTechnical();
      setStatus("walletIdle");
      window.dispatchEvent(new CustomEvent("cellscript:wallet-disconnected"));
      syncWorkflow();
    };
    const ensureWalletSigner = async () => {
      if (activeWalletSigner && activeWalletIdentity && (typeof activeWalletSigner.isConnected !== "function" || await activeWalletSigner.isConnected())) return activeWalletSigner;
      setStatus("walletWaiting");
      activeWalletSigner = await openWalletConnector();
      activeWalletIdentity = await readSignerIdentity(activeWalletSigner);
      const principalId = activeWalletIdentity.principalType === "joyid_ckb"
        ? await joyidPrincipalId(activeWalletIdentity.keyType!, activeWalletIdentity.publicKey)
        : await ckbPrincipalId(activeWalletIdentity.publicKey);
      const address = await readSignerAddress(activeWalletSigner);
      if (principalInput) {
        principalInput.value = principalId;
        principalInput.dataset.principalType = activeWalletIdentity.principalType;
      }
      if (copyPrincipalButton) copyPrincipalButton.dataset.copyText = principalId;
      localStorage.setItem(walletStorageKey, JSON.stringify({
        principalType: activeWalletIdentity.principalType,
        address,
        network: networkSelect?.value === "testnet" ? "testnet" : "mainnet",
        connectedAt: new Date().toISOString(),
      }));
      setStatus("walletConnected", "ok", address ? `: ${address}` : "");
      window.dispatchEvent(new CustomEvent("cellscript:wallet-connected", { detail: { principalType: activeWalletIdentity.principalType, address } }));
      return activeWalletSigner;
    };

    const signCapabilityPayload = async (): Promise<WalletSignature> => {
      const signer = await ensureWalletSigner();
      const identity = activeWalletIdentity;
      if (!identity) throw new WorkflowError("errorIdentityUnavailable");
      const payload = parsePayload();
      const challenge = canonicalJson(payload);
      if (payload.principal_type !== identity.principalType) throw new WorkflowError("errorPrincipalType");
      const expectedPrincipalId = identity.principalType === "joyid_ckb"
        ? await joyidPrincipalId(identity.keyType!, identity.publicKey)
        : await ckbPrincipalId(identity.publicKey);
      const payloadPrincipalId = typeof payload.principal_id === "string" ? payload.principal_id.trim().toLowerCase() : "";
      if (payloadPrincipalId !== expectedPrincipalId) throw new WorkflowError("errorPrincipalId", `Expected ${expectedPrincipalId}`);
      const rawSignature = await signer.signMessageRaw(challenge);
      if (identity.principalType === "joyid_ckb") {
        let signed: Record<string, unknown>;
        try { signed = JSON.parse(String(rawSignature)) as Record<string, unknown>; }
        catch { signed = { signature: rawSignature }; }
        if (typeof signed.signature !== "string" || !signed.signature) throw new WorkflowError("errorJoyidSignature");
        return {
          challenge,
          signature: signed.signature,
          message: typeof signed.message === "string" ? signed.message : challenge,
          pubkey: identity.publicKey,
          keyType: identity.keyType,
          alg: typeof signed.alg === "number" || typeof signed.alg === "string" ? signed.alg : undefined,
        };
      }
      let signature = String(rawSignature).trim();
      try {
        const parsed = JSON.parse(signature) as Record<string, unknown>;
        if (typeof parsed.signature === "string") signature = parsed.signature;
      } catch {
        // CCC CKB signers normally return a recoverable signature as hex.
      }
      if (!/^0x[0-9a-fA-F]{130}$/.test(signature)) throw new WorkflowError("errorCkbSignature");
      return { scheme: "ckb_secp256k1", challenge, signature: signature.toLowerCase(), public_key: identity.publicKey };
    };
    const writeSignature = (signature: WalletSignature) => {
      const text = JSON.stringify(signature, null, 2);
      if (signatureOutput) signatureOutput.value = text;
      if (copySignatureButton) copySignatureButton.dataset.copyText = text;
    };
    const signatureForPayload = (payload: Record<string, unknown>): WalletSignature => {
      if (!signatureOutput?.value.trim()) throw new WorkflowError("errorSigning");
      const signature = JSON.parse(signatureOutput.value) as WalletSignature;
      if (signature.challenge !== canonicalJson(payload)) throw new WorkflowError("errorPayloadChanged");
      return signature;
    };
    const readApiResponse = async (response: Response) => {
      const text = await response.text();
      let parsed: unknown;
      try { parsed = JSON.parse(text); }
      catch { parsed = { response: text }; }
      showTechnical({ status: response.status, response: parsed });
      return parsed;
    };
    const submitCapability = async () => {
      const payload = parsePayload();
      const signature = signatureForPayload(payload);
      const response = await fetch(`${signerRoot?.dataset.apiOrigin}/v1/capabilities`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ payload, wallet_signature: signature }),
        signal,
      });
      const parsed = await readApiResponse(response);
      if (!response.ok) throw new WorkflowError("errorCapabilityRejected", JSON.stringify({ status: response.status, response: parsed }, null, 2));
      capabilitySubmitted = true;
      setStatus("submitted", "ok");
    };
    const claimNamespace = async () => {
      const namespace = fieldValue("namespace");
      const name = fieldValue("name");
      if (!namespace) throw new WorkflowError("errorNamespaceRequired");
      const payload = parsePayload();
      const scopes = Array.isArray(payload.requested_scopes) ? payload.requested_scopes.filter((scope): scope is string => typeof scope === "string") : [];
      if (!scopes.includes(`publish:${namespace}/${name}`)) throw new WorkflowError("errorScope");
      const signature = signatureForPayload(payload);
      const response = await fetch(`${signerRoot?.dataset.apiOrigin}/v1/namespaces/claim`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ namespace, payload, wallet_signature: signature }),
        signal,
      });
      const parsed = await readApiResponse(response);
      if (!response.ok) throw new WorkflowError("errorClaimRejected", JSON.stringify({ status: response.status, response: parsed }, null, 2));
      namespaceClaimed = true;
      setStatus("continueDone", "ok");
    };

    primaryButton?.addEventListener("click", async () => {
      if (!coordinateValid()) {
        coordinateError?.removeAttribute("hidden");
        (namespaceInput?.validity.valid ? nameInput : namespaceInput)?.focus();
        setStatus("invalidCoordinate", "error");
        return;
      }
      busy = true;
      clearTechnical();
      syncWorkflow();
      try {
        if (!activeWalletSigner || !activeWalletIdentity) await ensureWalletSigner();
        else if (!hasValidPayload()) {
          payloadInput?.focus();
          parsePayload();
        } else if (!signatureOutput?.value.trim()) {
          writeSignature(await signCapabilityPayload());
          setStatus("signed", "ok");
        } else if (!capabilitySubmitted) await submitCapability();
        else if (!namespaceClaimed) await claimNamespace();
      } catch (error) {
        const fallback = !activeWalletSigner ? "errorWallet" : !signatureOutput?.value.trim() ? "errorSigning" : !capabilitySubmitted ? "errorSubmit" : "errorClaim";
        setError(error, fallback);
      } finally {
        busy = false;
        syncWorkflow();
      }
    }, { signal });
    changeWalletButton?.addEventListener("click", () => resetWallet(true), { signal });
    networkSelect?.addEventListener("change", () => resetWallet(true), { signal });
    existingCapability?.addEventListener("click", () => {
      authorisedOverride = true;
      clearTechnical();
      setStatus("alreadyAuthorised", "ok");
      syncWorkflow();
    }, { signal });
    payloadInput?.addEventListener("input", () => {
      clearSignature();
      clearTechnical();
      syncWorkflow();
    }, { signal });
    form?.addEventListener("input", (event) => {
      const coordinate = `${fieldValue("namespace")}/${fieldValue("name")}`;
      if (lastCoordinate && coordinate !== lastCoordinate && event.target !== form?.elements.namedItem("path")) {
        clearSignature();
        authorisedOverride = false;
      }
      lastCoordinate = coordinate;
      syncWorkflow();
    }, { signal });
    window.addEventListener("cellscript:locale-change", () => {
      setStatus(statusKey, statusTone, statusSuffix);
      syncWorkflow();
    }, { signal });
    document.addEventListener("astro:before-swap", () => {
      lifecycle.abort();
      activeConnector?.remove();
      activeConnector = null;
    }, { once: true });

    lastCoordinate = `${fieldValue("namespace")}/${fieldValue("name")}`;
    syncWorkflow();
  </script>
</RegistryLayout>
