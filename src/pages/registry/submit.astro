          <h3 id="registry-existing-capability-heading" data-i18n="registry.submit.existingCheckTitle">{t.registry.submit.existingCheckTitle}</h3>
          <p data-i18n="registry.submit.existingCheckBody">{t.registry.submit.existingCheckBody}</p>
        </div>
        <div class="registry-existing-capability-control">
          <label class="registry-builder-field">
            <span data-i18n="registry.submit.capabilityKeyId">{t.registry.submit.capabilityKeyId}</span>
            <input class="registry-input" data-existing-capability-key autocomplete="off" spellcheck="false" placeholder="cap_0123456789abcdef0123456789abcdef" />
          </label>
          <button class="registry-button primary" type="button" data-existing-capability-check data-i18n="registry.submit.checkCapability">{t.registry.submit.checkCapability}</button>
        </div>
        <dl class="registry-capability-check-summary" data-capability-check-summary hidden>
          <div><dt data-i18n="registry.submit.checkStatus">{t.registry.submit.checkStatus}</dt><dd data-capability-check-status></dd></div>
          <div><dt data-i18n="registry.submit.checkExpiry">{t.registry.submit.checkExpiry}</dt><dd data-capability-check-expiry></dd></div>
          <div><dt data-i18n="registry.submit.checkNamespace">{t.registry.submit.checkNamespace}</dt><dd data-capability-check-namespace></dd></div>
          <div><dt data-i18n="registry.submit.checkScopes">{t.registry.submit.checkScopes}</dt><dd data-capability-check-scopes></dd></div>
        </dl>
      </section>
    </section>

    <section class="registry-publish-step" data-publish-step data-state="locked" aria-labelledby="registry-publish-heading" hidden>
      <div class="registry-step-copy">
        <h2 id="registry-publish-heading" data-i18n="registry.submit.prTitle">{t.registry.submit.prTitle}</h2>
        <p data-i18n="registry.submit.prBody">{t.registry.submit.prBody}</p>
      </div>
      <div class="registry-step-code">
        <code data-submit-publish>cellc publish --capability-key-id &lt;server-confirmed-key-id&gt;</code>
        <button class="registry-copy" type="button" data-submit-publish-copy data-copy-text="" data-revert-label={t.registry.copy} data-i18n="registry.copy" disabled>{t.registry.copy}</button>
      </div>
    </section>
    </section>

    <dialog class="registry-wallet-dialog" data-wallet-dialog aria-labelledby="wallet-dialog-title">
      <div class="registry-wallet-dialog-shell">
        <header class="registry-wallet-dialog-head">
          <button class="registry-wallet-back" type="button" data-wallet-back hidden aria-label={t.registry.submit.walletBack} data-i18n-aria-label="registry.submit.walletBack">←</button>
          <div>
            <p class="registry-label" data-i18n="registry.submit.walletDialogLabel">{t.registry.submit.walletDialogLabel}</p>
            <h2 id="wallet-dialog-title" data-wallet-dialog-title data-i18n="registry.submit.walletChooseTitle">{t.registry.submit.walletChooseTitle}</h2>
          </div>
          <button class="registry-wallet-close" type="button" data-wallet-close aria-label={t.registry.submit.walletClose} data-i18n-aria-label="registry.submit.walletClose">×</button>
        </header>
        <p class="registry-wallet-dialog-body" data-wallet-dialog-body data-i18n="registry.submit.walletChooseBody">{t.registry.submit.walletChooseBody}</p>
        <div class="registry-wallet-toolbar">
          <label>
            <span class="sr-only" data-i18n="registry.submit.walletSearchPlaceholder">{t.registry.submit.walletSearchPlaceholder}</span>
            <input type="search" autocomplete="off" placeholder={t.registry.submit.walletSearchPlaceholder} data-i18n-placeholder="registry.submit.walletSearchPlaceholder" data-wallet-search />
          </label>
          <span data-wallet-count aria-live="polite"></span>
        </div>
        <div class="registry-wallet-options" data-wallet-options role="list"></div>
        <p class="registry-wallet-dialog-note" data-i18n="registry.submit.walletPrivacy">{t.registry.submit.walletPrivacy}</p>
      </div>
    </dialog>
  </section>

  <script>
    import { clearAuthorisationSession, readAuthorisationSession } from "../../lib/authorisation-session-storage.mjs";

    type PrincipalType = "joyid_ckb" | "ckb_secp256k1";
    type WalletIdentity = {
      principalType: PrincipalType;
      publicKey: string;
      keyType?: "main_key" | "sub_key";
    };
    type WalletSignature = Record<string, unknown> & {
      challenge: string;
      signature: string;
    };
    type WalletCatalogEntry = {
      name: string;
      aliases: string[];
      url: string;
      icon: string;
      mark: string;
    };
    type WalletSelection =
      | { kind: "signer"; signer: any }
      | { kind: "external"; wallet: WalletCatalogEntry };
    type AuthorisationMode = "new" | "existing";
    type CapabilityCheck = {
      key_id: string;
      status: "active" | "expired" | "revoked";
      scopes: string[];
      expires_at: string;
      namespace: { name: string; status: string; owned_by_capability_principal: boolean };
      allows: { publish: boolean; deployment: boolean; availability: boolean };
      usable_for_publish: boolean;
      reasons: string[];
    };
    type AuthorisationSession = {
      schema: "cellscript-registry-authorisation-session-v1";
      session_id: string;
      status: "pending" | "authorised" | "review_pending";
      artifact: { namespace: string; name: string; kind: string };
      requested_scopes: string[];
      capability_expires_at: string;
      expires_at: string;
    };

    class WorkflowError extends Error {
      constructor(readonly key: string, technical?: string) {
        super(technical || key);
      }
    }

    const lifecycle = new AbortController();
    const { signal } = lifecycle;
    const form = document.querySelector<HTMLFormElement>("[data-submit-form]");
    const publishEntry = document.querySelector<HTMLElement>("[data-publish-entry]");
    const manualPublish = document.querySelector<HTMLElement>("[data-manual-publish]");
    const openManualPublish = document.querySelector<HTMLButtonElement>("[data-open-manual-publish]");
    const closeManualPublish = document.querySelector<HTMLButtonElement>("[data-close-manual-publish]");
    const sessionPanel = document.querySelector<HTMLElement>("[data-authorisation-session]");
    const sessionTitle = document.querySelector<HTMLElement>("[data-session-title]");
    const sessionLead = document.querySelector<HTMLElement>("[data-session-lead]");
    const sessionCoordinate = document.querySelector<HTMLElement>("[data-session-coordinate]");
    const sessionKind = document.querySelector<HTMLElement>("[data-session-kind]");
    const sessionScope = document.querySelector<HTMLElement>("[data-session-scope]");
    const sessionExpiry = document.querySelector<HTMLElement>("[data-session-expiry]");
    const sessionIdOutput = document.querySelector<HTMLElement>("[data-session-id]");
    const sessionRetry = document.querySelector<HTMLButtonElement>("[data-session-retry]");
    const sessionStages = Array.from(document.querySelectorAll<HTMLElement>("[data-session-stage]"));
    const namespaceInput = form?.elements.namedItem("namespace") as HTMLInputElement | null;
    const nameInput = form?.elements.namedItem("name") as HTMLInputElement | null;
    const pathInput = form?.elements.namedItem("path") as HTMLInputElement | null;
    const artifactKindInput = form?.elements.namedItem("artifact_kind") as HTMLSelectElement | null;
    const artifactLanguageInput = form?.elements.namedItem("artifact_language") as HTMLSelectElement | null;
    const artifactKindHint = document.querySelector<HTMLElement>("[data-artifact-kind-hint]");
    const profileBuilder = document.querySelector<HTMLDetailsElement>("[data-profile-builder]");
    const profileGroups = Array.from(document.querySelectorAll<HTMLElement>("[data-profile-group]"));
    const profilePreview = document.querySelector<HTMLElement>("[data-profile-contract-preview]");
    const artifactManifestPreview = document.querySelector<HTMLElement>("[data-artifact-manifest-preview]");
    const artifactManifestCopy = document.querySelector<HTMLButtonElement>("[data-artifact-manifest-copy]");
    const artifactBundleCopy = document.querySelector<HTMLButtonElement>("[data-artifact-bundle-copy]");
    const coordinateError = document.querySelector<HTMLElement>("[data-coordinate-error]");
    const preflight = document.querySelector<HTMLElement>("[data-submit-preflight]");
    const preflightCopy = document.querySelector<HTMLButtonElement>("[data-submit-preflight-copy]");
    const capabilityCreateCommand = document.querySelector<HTMLElement>("[data-submit-create-capability]");
    const capabilityCreateCopy = document.querySelector<HTMLButtonElement>("[data-submit-create-capability-copy]");
    const capabilityCommand = document.querySelector<HTMLElement>("[data-submit-add]");
    const capabilityCopy = document.querySelector<HTMLButtonElement>("[data-submit-copy]");
    const publish = document.querySelector<HTMLElement>("[data-submit-publish]");
    const publishCopy = document.querySelector<HTMLButtonElement>("[data-submit-publish-copy]");
    const publishStep = document.querySelector<HTMLElement>("[data-publish-step]");
    const authorisationModes = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-authorisation-mode]"));
    const newCapabilityFlow = document.querySelector<HTMLElement>("[data-new-capability-flow]");
    const existingCapabilityPanel = document.querySelector<HTMLElement>("[data-existing-capability-panel]");
    const existingCapabilityKey = document.querySelector<HTMLInputElement>("[data-existing-capability-key]");
    const existingCapabilityCheck = document.querySelector<HTMLButtonElement>("[data-existing-capability-check]");
    const capabilityCheckSummary = document.querySelector<HTMLElement>("[data-capability-check-summary]");
    const capabilityCheckStatus = document.querySelector<HTMLElement>("[data-capability-check-status]");
    const capabilityCheckExpiry = document.querySelector<HTMLElement>("[data-capability-check-expiry]");
    const capabilityCheckNamespace = document.querySelector<HTMLElement>("[data-capability-check-namespace]");
    const capabilityCheckScopes = document.querySelector<HTMLElement>("[data-capability-check-scopes]");
    const signerRoot = document.querySelector<HTMLElement>("[data-capability-signer]");
    const principalPanel = document.querySelector<HTMLElement>("[data-principal-panel]");
    const principalInput = document.querySelector<HTMLInputElement>("[data-capability-principal]");
    const payloadPanel = document.querySelector<HTMLElement>("[data-payload-panel]");
    const payloadInput = document.querySelector<HTMLTextAreaElement>("[data-capability-payload]");
    const signaturePanel = document.querySelector<HTMLElement>("[data-signature-panel]");
    const signatureOutput = document.querySelector<HTMLTextAreaElement>("[data-capability-signature]");
    const signatureHint = document.querySelector<HTMLElement>("[data-signature-hint]");
    const capabilityActionButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-capability-action]"));
    const changeWalletButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-capability-change-wallet]"));
    const copyPrincipalButton = document.querySelector<HTMLButtonElement>("[data-capability-copy-principal]");
    const copySignatureButton = document.querySelector<HTMLButtonElement>("[data-capability-copy-signature]");
    const statusOutputs = Array.from(document.querySelectorAll<HTMLOutputElement>("[data-capability-status]"));
    const technicalDetails = document.querySelector<HTMLDetailsElement>("[data-capability-details]");
    const technicalOutput = document.querySelector<HTMLElement>("[data-capability-response]");
    const walletDialog = document.querySelector<HTMLDialogElement>("[data-wallet-dialog]");
    const walletDialogBody = document.querySelector<HTMLElement>("[data-wallet-dialog-body]");
    const walletOptions = document.querySelector<HTMLElement>("[data-wallet-options]");
    const walletToolbar = document.querySelector<HTMLElement>(".registry-wallet-toolbar");
    const walletSearch = document.querySelector<HTMLInputElement>("[data-wallet-search]");
    const walletCount = document.querySelector<HTMLElement>("[data-wallet-count]");
    const walletDialogTitle = document.querySelector<HTMLElement>("[data-wallet-dialog-title]");
    const walletBack = document.querySelector<HTMLButtonElement>("[data-wallet-back]");
    const walletClose = document.querySelector<HTMLButtonElement>("[data-wallet-close]");
    const stages = Array.from(document.querySelectorAll<HTMLElement>("[data-workflow-stage]"));
    const workflowGuide = document.querySelector<HTMLElement>("[data-workflow-guide]");
    const workflowGuideIndex = document.querySelector<HTMLElement>("[data-workflow-guide-index]");
    const workflowGuideTitle = document.querySelector<HTMLElement>("[data-workflow-guide-title]");
    const workflowGuideBody = document.querySelector<HTMLElement>("[data-workflow-guide-body]");
    const appLogo = `${window.location.origin}${import.meta.env.BASE_URL}cellscript-logo.png`;
    const registryNetwork = document.documentElement.dataset.registryNetwork === "testnet" ? "testnet" : "mainnet";
    const joyidPrincipalContext = "cellscript-registry-joyid-ckb-principal-v1";
    const ckbPrincipalContext = "cellscript-registry-ckb-secp256k1-principal-v1";
    const coordinatePattern = /^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$/;
    const walletIcon = (name: string) => `${import.meta.env.BASE_URL}wallets/${name}.svg`;
    const officialWalletCatalog: WalletCatalogEntry[] = [
      { name: "Neuron", aliases: ["Neuron"], url: "https://neuron.magickbase.com/", icon: walletIcon("neuron"), mark: "N" },
      { name: "JoyID", aliases: ["JoyID", "JoyID Passkey"], url: "https://joy.id/", icon: walletIcon("joyid"), mark: "J" },
      { name: "imToken", aliases: ["imToken"], url: "https://token.im/", icon: walletIcon("imtoken"), mark: "iM" },
      { name: "CKBull", aliases: ["CKBull"], url: "https://ckbull.app/", icon: walletIcon("ckbull"), mark: "CB" },
      { name: "SafePal", aliases: ["SafePal"], url: "https://blog.safepal.com/safepal-wallet-now-supports-nervos-ckb/", icon: walletIcon("safepal"), mark: "SP" },
      { name: "Ledger", aliases: ["Ledger"], url: "https://www.ledger.com/", icon: walletIcon("ledger"), mark: "L" },
      { name: "imKey", aliases: ["imKey"], url: "https://imkey.im/", icon: walletIcon("imkey"), mark: "iK" },
      { name: "OneKey", aliases: ["OneKey"], url: "https://onekey.so/", icon: walletIcon("onekey"), mark: "OK" },
      { name: "UTXO Global", aliases: ["UTXO Global", "UTXO Global Wallet"], url: "https://utxo.global/", icon: walletIcon("utxoglobal"), mark: "UG" },
      { name: "Rei Wallet", aliases: ["Rei Wallet", "Rei"], url: "https://reiwallet.io/", icon: walletIcon("reiwallet"), mark: "R" },
      { name: "Gate", aliases: ["Gate", "Gate Wallet"], url: "https://www.gate.io/", icon: walletIcon("gate"), mark: "G" },
      { name: "QuantumPurse", aliases: ["QuantumPurse"], url: "https://quantumpurse.org/", icon: walletIcon("quantumpurse"), mark: "QP" },
    ];
    const recoveredAuthorisationSession = readAuthorisationSession(window.location.href, sessionStorage);
    const authorisationSessionId = recoveredAuthorisationSession.sessionId;
    const authorisationBrowserToken = recoveredAuthorisationSession.browserToken;
    const authorisationSessionMode = recoveredAuthorisationSession.sessionMode;
    if (recoveredAuthorisationSession.cleanedUrl) {
      history.replaceState(history.state, "", recoveredAuthorisationSession.cleanedUrl);
    }

    const clearStoredAuthorisationSession = () => {
      clearAuthorisationSession(sessionStorage, authorisationSessionId);
    };

    let cccPromise: Promise<typeof import("@ckb-ccc/connector/barrel")> | null = null;
    let walletController: any | null = null;
    let availableWallets: any[] = [];
    let walletRefreshSequence = 0;
    let walletPicker: { resolve: (selection: WalletSelection) => void; reject: (error: unknown) => void; settled: boolean } | null = null;
    let activeWalletSigner: any | null = null;
    let activeWalletIdentity: WalletIdentity | null = null;
    let activeExternalWallet: WalletCatalogEntry | null = null;
    let authorisationMode: AuthorisationMode | null = null;
    let capabilitySubmitted = false;
    let submittedCapabilityKeyId = "";
    let namespaceClaimed = false;
    let namespaceReviewPending = false;
    let confirmedCapabilityKeyId = "";
    let lastCapabilityCheck: CapabilityCheck | null = null;
    let busy = false;
    let statusKey = "authorisationIdle";
    let statusTone: "idle" | "ok" | "error" = "idle";
    let statusSuffix = "";
    let lastCoordinate = "";
    let authorisationSession: AuthorisationSession | null = null;
    let authorisationChallengeToken = "";
    let authorisationSessionFinished = false;

    const message = (key: string): string => {
      const locale = document.documentElement.dataset.locale === "zh" ? "zh" : "en";
      const messages = (window as any).__CELLSCRIPT_I18N__?.[locale]?.registry?.submit;
      return typeof messages?.[key] === "string" ? messages[key] : key;
    };
    const preferredScrollBehavior: ScrollBehavior = window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
    const applyAuthorisationSessionLayout = () => {
      if (publishEntry) publishEntry.hidden = authorisationSessionMode;
      if (manualPublish) manualPublish.hidden = true;
      if (sessionPanel) {
        sessionPanel.hidden = !authorisationSessionMode;
        sessionPanel.dataset.state = authorisationSession ? "ready" : "loading";
      }
    };
    applyAuthorisationSessionLayout();

    const setStatus = (key: string, tone: "idle" | "ok" | "error" = "idle", suffix = "") => {
      statusKey = key;
      statusTone = tone;
      statusSuffix = suffix;
      for (const output of statusOutputs) {
        output.dataset.tone = tone;
        output.textContent = `${message(key)}${suffix}`;
        output.removeAttribute("data-i18n");
      }
    };
    const showTechnical = (value: unknown) => {
      if (!technicalDetails || !technicalOutput) return;
      technicalDetails.hidden = false;
      technicalOutput.textContent = typeof value === "string" ? value : JSON.stringify(value, null, 2);
    };
    const clearTechnical = () => {
      if (technicalDetails) {
        technicalDetails.hidden = true;
        technicalDetails.open = false;
      }
      if (technicalOutput) technicalOutput.textContent = "";
    };
    const setError = (error: unknown, fallbackKey: string) => {
      const key = error instanceof WorkflowError ? error.key : fallbackKey;
      setStatus(key, "error");
      if (error instanceof WorkflowError) {
        if (error.message !== error.key) showTechnical(error.message);
      } else if (error instanceof Error) showTechnical(error.message);
      else if (error != null) showTechnical(error);
    };
    const fieldValue = (name: string) => {
      const input = form?.elements.namedItem(name);
      return input instanceof HTMLInputElement || input instanceof HTMLSelectElement ? input.value.trim() : "";
    };
    const coordinateValid = () => coordinatePattern.test(fieldValue("namespace")) && coordinatePattern.test(fieldValue("name"));
    const shellQuote = (text: string) => /[\s"'$]/.test(text) ? `'${text.replace(/'/g, "'\\''")}'` : text;
    const commandPrefix = () => fieldValue("path") ? `cd ${shellQuote(fieldValue("path"))} && ` : "";

    const sortJson = (value: unknown): unknown => {
      if (Array.isArray(value)) return value.map(sortJson);
      if (value && typeof value === "object") {
        const output: Record<string, unknown> = {};
        for (const key of Object.keys(value as Record<string, unknown>).sort()) {
          const item = (value as Record<string, unknown>)[key];
          if (item !== undefined) output[key] = sortJson(item);
        }
        return output;
      }
      return value;
    };
    const canonicalJson = (value: unknown): string => JSON.stringify(sortJson(value));
    const sha256Hex = async (value: string): Promise<string> => {
      const hash = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
      return Array.from(new Uint8Array(hash), (byte) => byte.toString(16).padStart(2, "0")).join("");
    };
    const normalizePubkey = (value: string): string => {
      const trimmed = value.trim().toLowerCase();
      return trimmed.startsWith("0x") ? trimmed.slice(2) : trimmed;
    };
    const joyidPrincipalId = async (keyType: string, publicKey: string): Promise<string> =>
      `0x${await sha256Hex(`${joyidPrincipalContext}\n${keyType}\n${normalizePubkey(publicKey)}`)}`;
    const ckbPrincipalId = async (publicKey: string): Promise<string> => {
      const normalized = `0x${normalizePubkey(publicKey)}`;
      return `0x${await sha256Hex(`${ckbPrincipalContext}\n${normalized}`)}`;
    };

    const parsePayload = (): Record<string, unknown> => {
      if (!payloadInput?.value.trim()) throw new WorkflowError("errorPayloadRequired");
      let parsed: unknown;
      try {
        parsed = JSON.parse(payloadInput.value);
      } catch (error) {
        throw new WorkflowError("errorPayloadObject", error instanceof Error ? error.message : undefined);
      }
      const payload = parsed && typeof parsed === "object" && !Array.isArray(parsed) && "payload" in parsed
        ? (parsed as Record<string, unknown>).payload
        : parsed;
      if (!payload || typeof payload !== "object" || Array.isArray(payload)) throw new WorkflowError("errorPayloadObject");
      return payload as Record<string, unknown>;
    };
    const hasValidPayload = () => {
      try {
        parsePayload();
        return true;
      } catch {
        return false;
      }
    };

    const syncExternalPrincipal = () => {
      if (!activeExternalWallet || !principalInput) return;
      let principalId = "";
      let principalType = "";
      try {
        const payload = parsePayload();
        principalId = typeof payload.principal_id === "string" ? payload.principal_id.trim() : "";
        principalType = typeof payload.principal_type === "string" ? payload.principal_type.trim() : "";
      } catch {
        // An external wallet may still be preparing the capability payload.
      }
      principalInput.value = principalId;
      if (principalType) principalInput.dataset.principalType = principalType;
      else delete principalInput.dataset.principalType;
      if (copyPrincipalButton) copyPrincipalButton.dataset.copyText = principalId;
    };

    const updateCommands = () => {
      const namespace = fieldValue("namespace") || "<namespace>";
      const name = fieldValue("name") || "<name>";
      const principalId = principalInput?.value.trim() || "<principal_id>";
      const principalType = principalInput?.dataset.principalType || "<principal_type>";
      const artifactKind = artifactKindInput?.value || "source_library";
      const isCellScript = artifactKind === "source_library" || artifactKind === "profile_library";
      const cellscriptKindFlag = artifactKind === "profile_library" ? " --artifact-kind profile_library" : "";
      const registryApi = signerRoot?.dataset.apiOrigin || "https://api.registry.cellscript.dev";
      const apiFlag = ` --api-url ${shellQuote(registryApi)}`;
      const preflightCommand = isCellScript
        ? `${commandPrefix()}cellc package verify --json && cellc publish${cellscriptKindFlag}${apiFlag} --dry-run`
        : `${commandPrefix()}cellc publish --artifact-manifest Artifact.toml${apiFlag} --dry-run`;
      const createCapabilityCommand = `cellc auth capability create --registry-origin ${shellQuote(registryApi)} --principal-type ${shellQuote(principalType)} --principal-id ${shellQuote(principalId)} --scope ${shellQuote(`publish:${namespace}/${name}`)} --expires 90d --json > capability-payload.json`;
      const authCommand = `${createCapabilityCommand}\ncellc auth capability submit${apiFlag} --payload capability-payload.json --wallet-signature wallet-signature.json\ncellc auth namespace claim${apiFlag} --namespace ${shellQuote(namespace)} --payload capability-payload.json --wallet-signature wallet-signature.json`;
      const capabilityFlag = ` --capability-key-id ${shellQuote(confirmedCapabilityKeyId || "<server-confirmed-key-id>")}`;
      const publishCommand = isCellScript
        ? `${commandPrefix()}cellc publish${cellscriptKindFlag}${apiFlag}${capabilityFlag}`
        : `${commandPrefix()}cellc publish --artifact-manifest Artifact.toml${apiFlag}${capabilityFlag}`;
      if (preflight) preflight.textContent = preflightCommand;
      if (preflightCopy) preflightCopy.dataset.copyText = preflightCommand;
      if (capabilityCreateCommand) capabilityCreateCommand.textContent = createCapabilityCommand;
      if (capabilityCreateCopy) capabilityCreateCopy.dataset.copyText = createCapabilityCommand;
      if (capabilityCommand) capabilityCommand.textContent = authCommand;
      if (capabilityCopy) capabilityCopy.dataset.copyText = authCommand;
      if (publish) publish.textContent = publishCommand;
      if (publishCopy) publishCopy.dataset.copyText = confirmedCapabilityKeyId ? publishCommand : "";
    };

    const stageState = (name: string, complete: boolean, active: boolean) => {
      const stage = stages.find((item) => item.dataset.workflowStage === name);
      if (stage) stage.dataset.state = complete ? "complete" : active ? "active" : "pending";
    };
    const setWorkflowGuide = (index: "01" | "02" | "03", key: string, state: "active" | "complete" = "active") => {
      if (workflowGuide) workflowGuide.dataset.state = state;
      if (workflowGuideIndex) workflowGuideIndex.textContent = index;
      if (workflowGuideTitle) {
        workflowGuideTitle.dataset.i18n = `registry.submit.guide${key}Title`;
        workflowGuideTitle.textContent = message(`guide${key}Title`);
      }
      if (workflowGuideBody) {
        workflowGuideBody.dataset.i18n = `registry.submit.guide${key}Body`;
        workflowGuideBody.textContent = message(`guide${key}Body`);
      }
    };
    const setSessionStage = (name: string, state: "pending" | "active" | "complete", labelKey: string) => {
      const stage = sessionStages.find((item) => item.dataset.sessionStage === name);
      if (!stage) return;
      stage.dataset.state = state;
      const label = stage.querySelector<HTMLElement>("[data-session-stage-state]");
      if (label) {
        label.dataset.i18n = `registry.submit.${labelKey}`;
        label.textContent = message(labelKey);
      }
    };
    const syncSessionJourney = () => {
      if (!authorisationSessionMode || !authorisationSession) return;
      setSessionStage("local", "complete", "sessionStepComplete");
      if (!authorisationSessionFinished) {
        setSessionStage("approval", "active", busy ? "sessionStepWaiting" : "sessionStepCurrent");
        setSessionStage("publish", "pending", "sessionStepNext");
      } else {
        setSessionStage("approval", "complete", "sessionStepApproved");
        setSessionStage(
          "publish",
          namespaceReviewPending ? "pending" : "active",
          namespaceReviewPending ? "sessionStepAfterReview" : "sessionStepContinuing",
        );
      }
      if (sessionPanel) sessionPanel.toggleAttribute("data-busy", busy);
    };
    const syncWorkflow = () => {
      const coordinateReady = coordinateValid();
      const newMode = authorisationMode === "new";
      const existingMode = authorisationMode === "existing";
      const directSignerConnected = Boolean(activeWalletSigner && activeWalletIdentity);
      const manualSignatureMode = Boolean(activeExternalWallet);
      const signingRouteSelected = directSignerConnected || manualSignatureMode;
      const payloadReady = newMode
        && signingRouteSelected
        && hasValidPayload()
        && (!authorisationSessionMode || Boolean(authorisationChallengeToken));
      const signatureReady = payloadReady && Boolean(signatureOutput?.value.trim());
      if (newCapabilityFlow) newCapabilityFlow.hidden = !newMode;
      if (existingCapabilityPanel) existingCapabilityPanel.hidden = !existingMode;
      for (const button of authorisationModes) {
        const selected = button.dataset.authorisationMode === authorisationMode;
        button.setAttribute("aria-pressed", String(selected));
        button.disabled = busy || !coordinateReady;
      }
      stageState("wallet", newMode && signingRouteSelected, newMode && !signingRouteSelected);
      stageState("scope", newMode && signatureReady, newMode && signingRouteSelected && !signatureReady);
      stageState("authorise", authorisationSessionFinished || Boolean(confirmedCapabilityKeyId), newMode && signatureReady && !authorisationSessionFinished && !confirmedCapabilityKeyId);
      if (authorisationSessionFinished) {
        setWorkflowGuide("03", namespaceReviewPending ? "WaitForReview" : "ReturnToCli", "complete");
      } else if (!signingRouteSelected) {
        setWorkflowGuide("01", authorisationSessionMode ? "ConnectSessionWallet" : "ChooseRoute");
      } else if (authorisationSessionMode) {
        setWorkflowGuide("02", busy ? "ApprovalInProgress" : "ApproveSession");
      } else if (!payloadReady) {
        setWorkflowGuide("02", manualSignatureMode ? "PrepareExternalPayload" : "PreparePayload");
      } else if (!signatureReady) {
        setWorkflowGuide("02", manualSignatureMode ? "ImportSignature" : "ApproveScope");
      } else if (!capabilitySubmitted) {
        setWorkflowGuide("03", "SubmitAccess");
      } else if (!namespaceClaimed && !namespaceReviewPending) {
        setWorkflowGuide("03", "ClaimNamespace");
      } else {
        setWorkflowGuide("03", namespaceReviewPending ? "WaitForReview" : "PublishReady", "complete");
      }
      syncSessionJourney();
      if (principalPanel) principalPanel.hidden = !directSignerConnected && !(manualSignatureMode && principalInput?.value.trim());
      if (payloadPanel) payloadPanel.hidden = authorisationSessionMode || !newMode || !signingRouteSelected;
      if (signaturePanel) signaturePanel.hidden = authorisationSessionMode || !newMode || (!signatureReady && !manualSignatureMode);
      if (signatureHint) {
        const key = activeExternalWallet ? "signatureExternalHint" : "signatureReady";
        signatureHint.dataset.i18n = `registry.submit.${key}`;
        signatureHint.textContent = message(key);
      }
      for (const button of changeWalletButtons) button.hidden = !newMode || !signingRouteSelected || authorisationSessionFinished;
      const canPublish = !authorisationSessionMode && Boolean(confirmedCapabilityKeyId);
      if (publishStep) {
        publishStep.dataset.state = canPublish ? "ready" : "locked";
        publishStep.hidden = !canPublish;
      }
      if (publishCopy) publishCopy.disabled = !canPublish;

      for (const button of capabilityActionButtons) {
        const action = button.dataset.capabilityAction;
        if (action === "sign") {
          const labelKey = authorisationSessionMode ? "continueSubmit" : "continueSign";
          button.dataset.i18n = `registry.submit.${labelKey}`;
          button.textContent = message(labelKey);
        }
        const visible = action === "connect"
          ? newMode && !signingRouteSelected && !authorisationSessionFinished
          : action === "sign"
            ? newMode && directSignerConnected && (authorisationSessionMode || payloadReady) && !signatureReady && !authorisationSessionFinished
            : action === "submit"
              ? !authorisationSessionMode && newMode && signatureReady && !capabilitySubmitted && !authorisationSessionFinished
              : action === "claim"
                ? !authorisationSessionMode && newMode && capabilitySubmitted && !namespaceClaimed && !namespaceReviewPending
                : false;
        button.hidden = !visible;
        button.disabled = busy || !coordinateReady;
        button.setAttribute("aria-busy", String(busy && visible));
      }
      if (existingCapabilityCheck) {
        existingCapabilityCheck.disabled = busy
          || !existingMode
          || !coordinateReady
          || !/^cap_[0-9a-f]{32}$/.test(existingCapabilityKey?.value.trim().toLowerCase() ?? "");
        existingCapabilityCheck.setAttribute("aria-busy", String(busy && existingMode));
      }
      const valid = coordinateValid();
      for (const input of [namespaceInput, nameInput]) {
        if (input) input.setAttribute("aria-invalid", String(input.value.length > 0 && !coordinatePattern.test(input.value.trim())));
      }
      if (coordinateError) coordinateError.hidden = valid || (!namespaceInput?.value && !nameInput?.value);
      updateCommands();
    };

    const syncArtifactKind = () => {
      if (!artifactKindHint || !artifactKindInput) return;
      const hintKey = artifactKindInput.value === "deployable_contract"
        ? "kindCkbScriptHint"
        : artifactKindInput.value === "profile_library"
          ? "kindProfileLibraryHint"
        : artifactKindInput.value === "runtime_verifier"
          ? "kindRuntimeVerifierHint"
          : artifactKindInput.value === "reproducible_binary"
            ? "kindReproducibleBinaryHint"
            : artifactKindInput.value === "template"
              ? "kindTemplateHint"
              : "kindCellScriptHint";
      artifactKindHint.dataset.i18n = `registry.submit.${hintKey}`;
      artifactKindHint.textContent = message(hintKey);
      const kind = artifactKindInput.value;
      const generic = !["source_library", "profile_library"].includes(kind);
      const allowedLanguages: Record<string, string[]> = {
        source_library: ["cellscript"],
        profile_library: ["cellscript"],
        deployable_contract: ["cellscript", "rust", "c", "javascript", "other"],
        runtime_verifier: ["cellscript", "rust", "c", "javascript", "other"],
        reproducible_binary: ["rust", "c", "other"],
        template: ["cellscript", "rust", "c", "javascript", "other", "unspecified"],
      };
      if (artifactLanguageInput) {
        const allowed = allowedLanguages[kind] || ["other"];
        for (const option of artifactLanguageInput.options) option.hidden = !allowed.includes(option.value);
        if (!allowed.includes(artifactLanguageInput.value)) artifactLanguageInput.value = allowed[0];
        artifactLanguageInput.disabled = allowed.length === 1;
      }
      const reproducibleInput = form?.elements.namedItem("build_reproducible") as HTMLSelectElement | null;
      if (reproducibleInput) {
        if (kind === "reproducible_binary") reproducibleInput.value = "true";
        reproducibleInput.disabled = kind === "reproducible_binary";
      }
      const reproducible = kind === "reproducible_binary" || fieldValue("build_reproducible") === "true";
      if (profileBuilder) profileBuilder.hidden = !generic;
      for (const group of profileGroups) {
        const name = group.dataset.profileGroup;
        group.hidden = !generic || (name === "build" && kind === "template")
          || (name === "ckb" && !["deployable_contract", "runtime_verifier"].includes(kind))
          || (name === "verifier" && kind !== "runtime_verifier")
          || (name === "reproduction" && !reproducible)
          || (name === "copy" && kind !== "template");
      }
      if (!generic || !profilePreview || !artifactManifestPreview) return;
      const profile = ["deployable_contract", "runtime_verifier"].includes(kind)
        ? "ckb_executable"
        : kind === "reproducible_binary" ? "reproducible_build" : "copy_material";
      const contract: Record<string, unknown> = {
        schema: "cellscript-registry-profile-contract-v1",
        artifact_kind: kind,
        profile,
      };
      if (kind !== "template") {
        contract.build = {
          target: fieldValue("build_target") || "<target>",
          toolchain: fieldValue("toolchain") || "<pinned toolchain>",
          profile: "release",
          source_revision: fieldValue("source_revision") || "<source revision>",
          reproducible,
        };
        const securityStatus = fieldValue("security_status") || "review_required";
        contract.security = securityStatus === "audited"
          ? { status: securityStatus, audit_report_hash: "<audit_report object BLAKE2b-256>" }
          : { status: securityStatus };
      }
      if (["deployable_contract", "runtime_verifier"].includes(kind)) {
        contract.ckb = {
          vm_version: fieldValue("vm_version"),
          script_role: fieldValue("script_role"),
          hash_type: fieldValue("hash_type"),
          dep_type: fieldValue("dep_type"),
          abi_hash: "<ABI BLAKE2b-256>",
        };
      }
      if (kind === "runtime_verifier") {
        contract.verifier = {
          verifier_id: fieldValue("verifier_id") || "<verifier id>",
          ipc_abi: fieldValue("ipc_abi") || "<IPC ABI>",
          ipc_abi_hash: "<ABI BLAKE2b-256>",
        };
      }
      if (reproducible) {
        contract.reproduction = {
          environment: fieldValue("build_environment") || "<pinned environment>",
          command: fieldValue("build_command") || "<deterministic build command>",
          recipe_hash: "<build recipe BLAKE2b-256>",
          expected_artifact_hash: "<artifact BLAKE2b-256>",
        };
      }
      if (kind === "template") {
        contract.copy = { format: "file_map_v1", entrypoint: fieldValue("template_entrypoint") || "<entrypoint>" };
      }
      const release = fieldValue("artifact_release") || "1.0.0";
      const language = fieldValue("artifact_language") || "other";
      const manifest = [
        'schema = "cellscript-registry-artifact"',
        `namespace = ${JSON.stringify(fieldValue("namespace") || "<namespace>")}`,
        `name = ${JSON.stringify(fieldValue("name") || "<name>")}`,
        `release = ${JSON.stringify(release)}`,
        `kind = ${JSON.stringify(kind)}`,
        `language = ${JSON.stringify(language)}`,
        'bundle = "artifact.bundle.json"',
      ].join("\n");
      const roles = kind === "template"
        ? ["source"]
        : kind === "reproducible_binary"
          ? ["source", "executable", "build_recipe"]
          : ["source", "executable", "abi", ...(reproducible ? ["build_recipe"] : []), ...(fieldValue("security_status") === "audited" ? ["audit_report"] : [])];
      const bundle = JSON.stringify({
        schema: "cellscript-registry-bundle",
        namespace: fieldValue("namespace") || "<namespace>",
        name: fieldValue("name") || "<name>",
        release,
        profile,
        manifest_json: JSON.stringify(contract),
        objects: roles.map((role) => ({ role, content_base64: `<replace with base64 ${role} bytes>` })),
      }, null, 2);
      artifactManifestPreview.textContent = manifest;
      profilePreview.textContent = bundle;
      if (artifactManifestCopy) artifactManifestCopy.dataset.copyText = manifest;
      if (artifactBundleCopy) artifactBundleCopy.dataset.copyText = bundle;
    };

    const loadCCC = async () => {
      cccPromise ??= import("@ckb-ccc/connector/barrel");
      return cccPromise;
    };
    const createCkbOnlyController = (ccc: typeof import("@ckb-ccc/connector/barrel")) => new class extends ccc.SignersController {
      async refresh(client: any, onUpdate: (wallets: any[]) => void, configs?: any) {
        const ckbWallets = new Map<string, any>();
        await super.refresh(client, (wallets: any[]) => {
          for (const wallet of wallets) {
            const signers = wallet.signers.filter((info: any) => info.signer?.type === ccc.SignerType.CKB);
            if (signers.length > 0) {
              ckbWallets.set(wallet.name, {
                ...wallet,
                signers,
                installOnly: signers.every((info: any) => info.signer instanceof ccc.SignerOpenLink),
              });
            }
          }
          onUpdate([...ckbWallets.values()]);
        }, configs);
      }
    }();

    const setWalletDialogTitle = (key: string, fallback?: string) => {
      if (!walletDialogTitle) return;
      walletDialogTitle.textContent = fallback || message(key);
      if (fallback) walletDialogTitle.removeAttribute("data-i18n");
      else walletDialogTitle.dataset.i18n = `registry.submit.${key}`;
    };
    const transitionWalletOptions = (render: () => void) => {
      if (!walletOptions) return;
      walletOptions.classList.remove("is-entering");
      walletOptions.replaceChildren();
      render();
      requestAnimationFrame(() => walletOptions.classList.add("is-entering"));
    };
    const walletOptionButton = (
      label: string,
      detail: string,
      icon: string | undefined,
      onClick: () => void,
      fallbackMark?: string,
      mode: "direct" | "manual" = "manual",
    ) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "registry-wallet-option";
      button.setAttribute("role", "listitem");
      button.dataset.connectMode = mode;
      button.dataset.walletSearch = `${label} ${detail}`.toLowerCase();
      if (icon) {
        const image = document.createElement("img");
        image.src = icon;
        image.alt = "";
        image.decoding = "async";
        button.append(image);
      } else {
        const markNode = document.createElement("span");
        markNode.className = "registry-wallet-option-mark";
        markNode.textContent = fallbackMark || label.slice(0, 1).toUpperCase();
        button.append(markNode);
      }
      const copy = document.createElement("span");
      const name = document.createElement("strong");
      name.textContent = label;
      const meta = document.createElement("small");
      meta.textContent = detail;
      copy.append(name, meta);
      const arrow = document.createElement("span");
      arrow.className = "registry-wallet-option-arrow";
      arrow.setAttribute("aria-hidden", "true");
      arrow.textContent = "→";
      button.append(copy, arrow);
      button.addEventListener("click", onClick, { signal });
      return button;
    };
    const walletGroup = (label: string, items: HTMLButtonElement[], mode: "direct" | "manual") => {
      const section = document.createElement("section");
      section.className = "registry-wallet-group";
      section.dataset.walletGroup = "";
      section.dataset.groupMode = mode;
      const heading = document.createElement("div");
      const title = document.createElement("strong");
      title.textContent = label;
      const count = document.createElement("span");
      count.textContent = String(items.length).padStart(2, "0");
      heading.append(title, count);
      const list = document.createElement("div");
      list.append(...items);
      section.append(heading, list);
      return section;
    };
    const applyWalletSearch = () => {
      const query = walletSearch?.value.trim().toLowerCase() || "";
      let direct = 0;
      let external = 0;
      for (const button of walletOptions?.querySelectorAll<HTMLButtonElement>(".registry-wallet-option") || []) {
        button.hidden = Boolean(query) && !(button.dataset.walletSearch || "").includes(query);
        if (!button.hidden) {
          if (button.dataset.connectMode === "direct") direct += 1;
          else external += 1;
        }
      }
      for (const group of walletOptions?.querySelectorAll<HTMLElement>("[data-wallet-group]") || []) {
        group.hidden = !group.querySelector(".registry-wallet-option:not([hidden])");
      }
      if (walletCount) {
        walletCount.textContent = authorisationSessionMode
          ? message("walletCountDirect").replace("{direct}", String(direct))
          : message("walletCount").replace("{direct}", String(direct)).replace("{external}", String(external));
      }
    };
    walletSearch?.addEventListener("input", applyWalletSearch, { signal });
    const renderWalletEmpty = (key = "walletEmpty") => {
      if (walletToolbar) walletToolbar.hidden = true;
      transitionWalletOptions(() => {
        const empty = document.createElement("p");
        empty.className = "registry-wallet-empty";
        empty.textContent = message(key);
        walletOptions?.append(empty);
      });
    };
    const connectWalletSigner = async (wallet: any, signerInfo: any) => {
      if (!walletOptions || !walletPicker) return;
      if (walletToolbar) walletToolbar.hidden = true;
      transitionWalletOptions(() => {
        const state = document.createElement("div");
        state.className = "registry-wallet-connecting";
        const pulse = document.createElement("span");
        pulse.setAttribute("aria-hidden", "true");
        const copy = document.createElement("div");
        const title = document.createElement("strong");
        title.textContent = message("walletConnecting");
        const detail = document.createElement("small");
        detail.textContent = wallet.name;
        copy.append(title, detail);
        state.append(pulse, copy);
        walletOptions.append(state);
      });
      try {
        await signerInfo.signer.connect();
        if (typeof signerInfo.signer.isConnected === "function" && !(await signerInfo.signer.isConnected())) {
          throw new WorkflowError("errorNoWallet");
        }
        const picker = walletPicker;
        if (!picker || picker.settled) return;
        picker.settled = true;
        picker.resolve({ kind: "signer", signer: signerInfo.signer });
        walletDialog?.close();
      } catch (error) {
        renderWalletEmpty(error instanceof Error && error.message ? "errorWallet" : "errorNoWallet");
        setError(error, "errorWallet");
      }
    };
    const renderSignerChoices = (wallet: any) => {
      setWalletDialogTitle("walletSignerTitle", wallet.name);
      if (walletBack) walletBack.hidden = false;
      if (walletToolbar) walletToolbar.hidden = true;
      transitionWalletOptions(() => {
        for (const signerInfo of wallet.signers) {
          walletOptions?.append(walletOptionButton(
            signerInfo.name || wallet.name,
            message("walletCkbSigner"),
            wallet.icon,
            () => void connectWalletSigner(wallet, signerInfo),
          ));
        }
      });
    };
    const walletNameKey = (value: string) => value.trim().toLowerCase().replaceAll(/[^a-z0-9]/g, "");
    const discoveredCatalogWallet = (entry: WalletCatalogEntry) => {
      const aliases = new Set(entry.aliases.map(walletNameKey));
      return availableWallets.find((wallet) => aliases.has(walletNameKey(String(wallet.name || ""))));
    };
    const selectExternalWallet = (wallet: WalletCatalogEntry) => {
      window.open(wallet.url, "_blank", "noopener,noreferrer");
      const picker = walletPicker;
      if (!picker || picker.settled) return;
      picker.settled = true;
      picker.resolve({ kind: "external", wallet });
      walletDialog?.close();
    };
    const renderWalletChoices = () => {
      setWalletDialogTitle("walletChooseTitle");
      if (walletDialogBody) {
        const bodyKey = authorisationSessionMode ? "walletSessionChooseBody" : "walletChooseBody";
        walletDialogBody.dataset.i18n = `registry.submit.${bodyKey}`;
        walletDialogBody.textContent = message(bodyKey);
      }
      if (walletBack) walletBack.hidden = true;
      if (walletToolbar) walletToolbar.hidden = false;
      if (walletSearch) walletSearch.value = "";
      transitionWalletOptions(() => {
        const claimed = new Set<string>();
        const direct: HTMLButtonElement[] = [];
        const directory: HTMLButtonElement[] = [];
        for (const catalogWallet of officialWalletCatalog) {
          const wallet = discoveredCatalogWallet(catalogWallet);
          if (wallet) claimed.add(walletNameKey(String(wallet.name || "")));
          const directlyConnectable = wallet && !wallet.installOnly && wallet.signers.length > 0;
          let detail = directlyConnectable ? message("walletDirect") : message("walletExternal");
          if (directlyConnectable && wallet.signers.length > 1) {
            detail = message("walletMultipleSigners").replace("{count}", String(wallet.signers.length));
          }
          const option = walletOptionButton(
            catalogWallet.name,
            detail,
            catalogWallet.icon,
            () => directlyConnectable
              ? wallet.signers.length === 1
                ? void connectWalletSigner(wallet, wallet.signers[0])
                : renderSignerChoices(wallet)
              : selectExternalWallet(catalogWallet),
            catalogWallet.mark,
            directlyConnectable ? "direct" : "manual",
          );
          (directlyConnectable ? direct : directory).push(option);
        }
        for (const wallet of availableWallets) {
          if (claimed.has(walletNameKey(String(wallet.name || ""))) || wallet.installOnly || wallet.signers.length === 0) continue;
          const detail = wallet.signers.length > 1
            ? message("walletMultipleSigners").replace("{count}", String(wallet.signers.length))
            : message("walletDirect");
          direct.push(walletOptionButton(
            wallet.name,
            detail,
            wallet.icon,
            () => wallet.signers.length === 1
              ? void connectWalletSigner(wallet, wallet.signers[0])
              : renderSignerChoices(wallet),
            undefined,
            "direct",
          ));
        }
        if (direct.length) walletOptions?.append(walletGroup(message("walletAvailableNow"), direct, "direct"));
        if (!authorisationSessionMode && directory.length) {
          walletOptions?.append(walletGroup(message("walletDirectory"), directory, "manual"));
        }
      });
      applyWalletSearch();
    };
    const refreshWalletChoices = async () => {
      const sequence = ++walletRefreshSequence;
      setWalletDialogTitle("walletChooseTitle");
      if (walletBack) walletBack.hidden = true;
      renderWalletEmpty("walletLoading");
      try {
        const ccc = await loadCCC();
        walletController ??= createCkbOnlyController(ccc);
        const client = registryNetwork === "testnet" ? new ccc.ClientPublicTestnet() : new ccc.ClientPublicMainnet();
        let discoveredWallets: any[] = [];
        await walletController.refresh(client, (wallets: any[]) => {
          if (sequence !== walletRefreshSequence) return;
          discoveredWallets = wallets;
        }, {
          name: "CellScript Registry",
          icon: appLogo,
          preferredNetworks: [{
            addressPrefix: registryNetwork === "testnet" ? "ckt" : "ckb",
            signerType: ccc.SignerType.CKB,
            network: registryNetwork,
          }],
        });
        if (sequence !== walletRefreshSequence) return;
        availableWallets = discoveredWallets;
        renderWalletChoices();
      } catch (error) {
        if (sequence !== walletRefreshSequence) return;
        availableWallets = [];
        renderWalletChoices();
        setError(error, "errorWallet");
      }
    };

    const readSignerIdentity = async (signer: any): Promise<WalletIdentity> => {
      const raw = typeof signer.getIdentity === "function" ? await signer.getIdentity() : undefined;
      if (typeof raw !== "string" || !raw.trim()) throw new WorkflowError("errorPublicKey");
      try {
        const parsed = JSON.parse(raw) as Record<string, unknown>;
        const publicKey = typeof parsed.publicKey === "string" ? parsed.publicKey : "";
        const keyType = parsed.keyType;
        if (publicKey && (keyType === "main_key" || keyType === "sub_key")) return { principalType: "joyid_ckb", publicKey, keyType };
        if (/^(?:0x)?(?:02|03)[0-9a-fA-F]{64}$/.test(publicKey)) return { principalType: "ckb_secp256k1", publicKey: `0x${normalizePubkey(publicKey)}` };
      } catch {
        // Standard CKB signers expose the compressed public key directly.
      }
      if (/^(?:0x)?(?:02|03)[0-9a-fA-F]{64}$/.test(raw.trim())) return { principalType: "ckb_secp256k1", publicKey: `0x${normalizePubkey(raw)}` };
      throw new WorkflowError("errorUnsupportedIdentity");
    };
    const readSignerAddress = async (signer: any): Promise<string | undefined> => {
      try {
        return typeof signer.getInternalAddress === "function" ? await signer.getInternalAddress() : undefined;
      } catch {
        return undefined;
      }
    };
    const openWalletConnector = (): Promise<WalletSelection> => {
      if (!walletDialog || !walletOptions) return Promise.reject(new WorkflowError("errorWallet"));
      if (walletPicker && !walletPicker.settled) {
        walletPicker.settled = true;
        walletPicker.reject(new WorkflowError("errorNoWallet"));
      }
      if (!walletDialog.open) walletDialog.showModal();
      void refreshWalletChoices();
      return new Promise((resolve, reject) => {
        walletPicker = { resolve, reject, settled: false };
      });
    };

    const clearCapabilityConfirmation = () => {
      confirmedCapabilityKeyId = "";
      lastCapabilityCheck = null;
      if (capabilityCheckSummary) capabilityCheckSummary.hidden = true;
      if (capabilityCheckStatus) capabilityCheckStatus.textContent = "";
      if (capabilityCheckExpiry) capabilityCheckExpiry.textContent = "";
      if (capabilityCheckNamespace) capabilityCheckNamespace.textContent = "";
      if (capabilityCheckScopes) capabilityCheckScopes.textContent = "";
    };
    const clearSignature = () => {
      if (signatureOutput) signatureOutput.value = "";
      if (copySignatureButton) copySignatureButton.dataset.copyText = "";
      authorisationChallengeToken = "";
      capabilitySubmitted = false;
      submittedCapabilityKeyId = "";
      namespaceClaimed = false;
      namespaceReviewPending = false;
      clearCapabilityConfirmation();
    };
    const resetWallet = async (disconnect = false) => {
      if (disconnect && typeof activeWalletSigner?.disconnect === "function") {
        try { await activeWalletSigner.disconnect(); } catch { /* Wallet may already be closed. */ }
      }
      activeWalletSigner = null;
      activeWalletIdentity = null;
      activeExternalWallet = null;
      signatureOutput?.setAttribute("readonly", "");
      if (principalInput) {
        principalInput.value = "";
        delete principalInput.dataset.principalType;
      }
      if (copyPrincipalButton) copyPrincipalButton.dataset.copyText = "";
      clearSignature();
      clearTechnical();
      setStatus("walletIdle");
      window.dispatchEvent(new CustomEvent("cellscript:wallet-disconnected"));
      syncWorkflow();
    };
    const ensureWalletSigner = async () => {
      if (activeWalletSigner && activeWalletIdentity && (typeof activeWalletSigner.isConnected !== "function" || await activeWalletSigner.isConnected())) return activeWalletSigner;
      setStatus("walletWaiting");
      const selection = await openWalletConnector();
      if (selection.kind === "external") {
        if (authorisationSessionMode) throw new WorkflowError("errorSessionExternal");
        activeWalletSigner = null;
        activeWalletIdentity = null;
        activeExternalWallet = selection.wallet;
        if (principalInput) {
          principalInput.value = "";
          delete principalInput.dataset.principalType;
        }
        if (copyPrincipalButton) copyPrincipalButton.dataset.copyText = "";
        clearSignature();
        signatureOutput?.removeAttribute("readonly");
        setStatus("walletExternalReady", "idle", `: ${selection.wallet.name}`);
        syncWorkflow();
        return null;
      }
      activeExternalWallet = null;
      signatureOutput?.setAttribute("readonly", "");
      activeWalletSigner = selection.signer;
      activeWalletIdentity = await readSignerIdentity(activeWalletSigner);
      const principalId = activeWalletIdentity.principalType === "joyid_ckb"
        ? await joyidPrincipalId(activeWalletIdentity.keyType!, activeWalletIdentity.publicKey)
        : await ckbPrincipalId(activeWalletIdentity.publicKey);
      const address = await readSignerAddress(activeWalletSigner);
      if (principalInput) {
        principalInput.value = principalId;
        principalInput.dataset.principalType = activeWalletIdentity.principalType;
      }
      if (copyPrincipalButton) copyPrincipalButton.dataset.copyText = principalId;
      setStatus("walletConnected", "ok", address ? `: ${address}` : "");
      window.dispatchEvent(new CustomEvent("cellscript:wallet-connected", { detail: { principalType: activeWalletIdentity.principalType, address } }));
      return activeWalletSigner;
    };

    const signCapabilityPayload = async (): Promise<WalletSignature> => {
      const signer = await ensureWalletSigner();
      if (!signer) throw new WorkflowError("errorExternalSignature");
      const identity = activeWalletIdentity;
      if (!identity) throw new WorkflowError("errorIdentityUnavailable");
      const payload = parsePayload();
      const challenge = canonicalJson(payload);
      if (payload.principal_type !== identity.principalType) throw new WorkflowError("errorPrincipalType");
      const expectedPrincipalId = identity.principalType === "joyid_ckb"
        ? await joyidPrincipalId(identity.keyType!, identity.publicKey)
        : await ckbPrincipalId(identity.publicKey);
      const payloadPrincipalId = typeof payload.principal_id === "string" ? payload.principal_id.trim().toLowerCase() : "";
      if (payloadPrincipalId !== expectedPrincipalId) throw new WorkflowError("errorPrincipalId", `Expected ${expectedPrincipalId}`);
      const rawSignature = await signer.signMessageRaw(challenge);
      if (identity.principalType === "joyid_ckb") {
        let signed: Record<string, unknown>;
        try { signed = JSON.parse(String(rawSignature)) as Record<string, unknown>; }
        catch { signed = { signature: rawSignature }; }
        if (typeof signed.signature !== "string" || !signed.signature) throw new WorkflowError("errorJoyidSignature");
        return {
          challenge,
          signature: signed.signature,
          message: typeof signed.message === "string" ? signed.message : challenge,
          pubkey: identity.publicKey,
          keyType: identity.keyType,
          alg: typeof signed.alg === "number" || typeof signed.alg === "string" ? signed.alg : undefined,
        };
      }
      let signature = String(rawSignature).trim();
      try {
        const parsed = JSON.parse(signature) as Record<string, unknown>;
        if (typeof parsed.signature === "string") signature = parsed.signature;
      } catch {
        // CCC CKB signers normally return a recoverable signature as hex.
      }
      if (!/^0x[0-9a-fA-F]{130}$/.test(signature)) throw new WorkflowError("errorCkbSignature");
      return { scheme: "ckb_secp256k1", challenge, signature: signature.toLowerCase(), public_key: identity.publicKey };
    };
    const writeSignature = (signature: WalletSignature) => {
      const text = JSON.stringify(signature, null, 2);
      if (signatureOutput) signatureOutput.value = text;
      if (copySignatureButton) copySignatureButton.dataset.copyText = text;
    };
    const signatureForPayload = async (payload: Record<string, unknown>): Promise<WalletSignature> => {
      if (!signatureOutput?.value.trim()) throw new WorkflowError("errorSigning");
      let signature: WalletSignature;
      try {
        signature = JSON.parse(signatureOutput.value) as WalletSignature;
      } catch (error) {
        throw new WorkflowError("errorSigning", error instanceof Error ? error.message : undefined);
      }
      if (signature.challenge !== canonicalJson(payload)) throw new WorkflowError("errorPayloadChanged");
      const principalType = typeof payload.principal_type === "string" ? payload.principal_type : "";
      const principalId = typeof payload.principal_id === "string" ? payload.principal_id.trim().toLowerCase() : "";
      if (principalType === "ckb_secp256k1") {
        if (signature.scheme !== "ckb_secp256k1"
          || typeof signature.public_key !== "string"
          || !/^(?:0x)?(?:02|03)[0-9a-fA-F]{64}$/.test(signature.public_key)
          || typeof signature.signature !== "string"
          || !/^0x[0-9a-fA-F]{130}$/.test(signature.signature)) {
          throw new WorkflowError("errorCkbSignature");
        }
        if (principalId !== await ckbPrincipalId(signature.public_key)) throw new WorkflowError("errorPrincipalId");
      } else if (principalType === "joyid_ckb") {
        if (typeof signature.pubkey !== "string"
          || (signature.keyType !== "main_key" && signature.keyType !== "sub_key")
          || typeof signature.signature !== "string"
          || !signature.signature) {
          throw new WorkflowError("errorJoyidSignature");
        }
        if (principalId !== await joyidPrincipalId(signature.keyType, signature.pubkey)) throw new WorkflowError("errorPrincipalId");
      } else {
        throw new WorkflowError("errorUnsupportedIdentity");
      }
      return signature;
    };
    const readApiResponse = async (response: Response, reveal = true) => {
      const text = await response.text();
      let parsed: unknown;
      try { parsed = JSON.parse(text); }
      catch { parsed = { response: text }; }
      if (reveal) showTechnical({ status: response.status, response: parsed });
      return parsed;
    };
    const isAuthorisationSession = (value: unknown): value is AuthorisationSession => {
      if (!value || typeof value !== "object" || Array.isArray(value)) return false;
      const session = value as Partial<AuthorisationSession>;
      return session.schema === "cellscript-registry-authorisation-session-v1"
        && session.session_id === authorisationSessionId
        && (session.status === "pending" || session.status === "authorised" || session.status === "review_pending")
        && Boolean(session.artifact)
        && typeof session.artifact?.namespace === "string"
        && typeof session.artifact?.name === "string"
        && typeof session.artifact?.kind === "string"
        && Array.isArray(session.requested_scopes)
        && session.requested_scopes.every((scope) => typeof scope === "string")
        && typeof session.capability_expires_at === "string"
        && typeof session.expires_at === "string";
    };
    const artifactKindLabel = (kind: string) => {
      const key = ({
        source_library: "kindCellScript",
        profile_library: "kindProfileLibrary",
        deployable_contract: "kindCkbScript",
        runtime_verifier: "kindRuntimeVerifier",
        reproducible_binary: "kindReproducibleBinary",
        template: "kindTemplate",
      } as Record<string, string>)[kind];
      return key ? message(key) : kind.replaceAll("_", " ");
    };
    const setSessionCopy = (status: "pending" | "authorised" | "review_pending" | "error") => {
      const prefix = status === "authorised"
        ? "sessionCompleted"
        : status === "review_pending"
          ? "sessionReview"
          : status === "error"
            ? "sessionError"
            : "sessionApproval";
      if (sessionTitle) {
        sessionTitle.dataset.i18n = `registry.submit.${prefix}Title`;
        sessionTitle.textContent = message(`${prefix}Title`);
      }
      if (sessionLead) {
        sessionLead.dataset.i18n = `registry.submit.${prefix}Body`;
        sessionLead.textContent = message(`${prefix}Body`);
      }
    };
    const renderAuthorisationSession = (session: AuthorisationSession) => {
      authorisationSession = session;
      const locale = document.documentElement.dataset.locale === "zh" ? "zh-CN" : "en-GB";
      const formatter = new Intl.DateTimeFormat(locale, { dateStyle: "medium", timeStyle: "short" });
      if (sessionCoordinate) sessionCoordinate.textContent = `${session.artifact.namespace}/${session.artifact.name}`;
      if (sessionKind) sessionKind.textContent = artifactKindLabel(session.artifact.kind);
      if (sessionScope) sessionScope.textContent = session.requested_scopes.join(" · ");
      if (sessionExpiry) sessionExpiry.textContent = formatter.format(new Date(session.expires_at));
      if (sessionIdOutput) sessionIdOutput.textContent = session.session_id;
      if (sessionPanel) sessionPanel.dataset.state = session.status;
      setSessionCopy(session.status);
      if (namespaceInput) namespaceInput.value = session.artifact.namespace;
      if (nameInput) nameInput.value = session.artifact.name;
      if (artifactKindInput) artifactKindInput.value = session.artifact.kind;
      authorisationMode = "new";
      authorisationSessionFinished = session.status !== "pending";
      namespaceReviewPending = session.status === "review_pending";
      if (session.status === "authorised") {
        clearStoredAuthorisationSession();
        setStatus("sessionCompleted", "ok");
      } else if (session.status === "review_pending") {
        clearStoredAuthorisationSession();
        setStatus("sessionReviewPending", "idle");
      }
      else setStatus("sessionReady");
      lastCoordinate = `${session.artifact.namespace}/${session.artifact.name}`;
      syncArtifactKind();
      syncWorkflow();
    };
    const loadAuthorisationSession = async () => {
      if (!authorisationSessionMode) return;
      if (!/^browser_[0-9a-f]{32}$/.test(authorisationBrowserToken)) throw new WorkflowError("errorSessionLoad");
      const apiOrigin = signerRoot?.dataset.apiOrigin;
      if (!apiOrigin) throw new WorkflowError("errorSessionLoad");
      const response = await fetch(`${apiOrigin}/v1/authorisation-sessions/${encodeURIComponent(authorisationSessionId)}`, {
        headers: { accept: "application/json", authorization: `Bearer ${authorisationBrowserToken}` },
        signal,
      });
      const parsed = await readApiResponse(response, false);
      if (response.status === 410) {
        clearStoredAuthorisationSession();
        throw new WorkflowError("errorSessionExpired", JSON.stringify(parsed, null, 2));
      }
      if (!response.ok) throw new WorkflowError("errorSessionLoad", JSON.stringify({ status: response.status, response: parsed }, null, 2));
      if (!isAuthorisationSession(parsed)) throw new WorkflowError("errorSessionResponse");
      if (!coordinatePattern.test(parsed.artifact.namespace) || !coordinatePattern.test(parsed.artifact.name)) {
        throw new WorkflowError("errorSessionResponse");
      }
      renderAuthorisationSession(parsed);
    };
    const prepareAuthorisationSessionChallenge = async () => {
      if (!authorisationSession || authorisationSession.status !== "pending") throw new WorkflowError("errorSessionLoad");
      if (!activeWalletIdentity || !principalInput?.value.trim()) throw new WorkflowError("errorIdentityUnavailable");
      setStatus("sessionPreparing");
      const response = await fetch(`${signerRoot?.dataset.apiOrigin}/v1/authorisation-sessions/${encodeURIComponent(authorisationSessionId)}/challenge`, {
        method: "POST",
        headers: { "content-type": "application/json", accept: "application/json", authorization: `Bearer ${authorisationBrowserToken}` },
        body: JSON.stringify({
          principal_type: activeWalletIdentity.principalType,
          principal_id: principalInput.value.trim(),
        }),
        signal,
      });
      const parsed = await readApiResponse(response, false);
      if (!response.ok) throw new WorkflowError("errorSessionLoad", JSON.stringify({ status: response.status, response: parsed }, null, 2));
      if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) throw new WorkflowError("errorSessionResponse");
      const challenge = parsed as Record<string, unknown>;
      if (typeof challenge.challenge_token !== "string" || !challenge.challenge_token.startsWith("challenge_")
        || !challenge.payload || typeof challenge.payload !== "object" || Array.isArray(challenge.payload)) {
        throw new WorkflowError("errorSessionResponse");
      }
      authorisationChallengeToken = challenge.challenge_token;
      if (payloadInput) payloadInput.value = JSON.stringify({ payload: challenge.payload }, null, 2);
    };
    const completeAuthorisationSession = async () => {
      if (!authorisationChallengeToken) throw new WorkflowError("errorSessionResponse");
      const payload = parsePayload();
      const signature = await signatureForPayload(payload);
      const response = await fetch(`${signerRoot?.dataset.apiOrigin}/v1/authorisation-sessions/${encodeURIComponent(authorisationSessionId)}/complete`, {
        method: "POST",
        headers: { "content-type": "application/json", accept: "application/json", authorization: `Bearer ${authorisationBrowserToken}` },
        body: JSON.stringify({ challenge_token: authorisationChallengeToken, wallet_signature: signature }),
        signal,
      });
      const parsed = await readApiResponse(response, !response.ok);
      if (!response.ok) throw new WorkflowError("errorSubmit", JSON.stringify({ status: response.status, response: parsed }, null, 2));
      if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) throw new WorkflowError("errorSessionResponse");
      const completedStatus = (parsed as Record<string, unknown>).status;
      if (completedStatus !== "authorised" && completedStatus !== "review_pending") throw new WorkflowError("errorSessionResponse");
      capabilitySubmitted = true;
      namespaceReviewPending = completedStatus === "review_pending";
      authorisationSessionFinished = true;
      clearStoredAuthorisationSession();
      if (sessionPanel) sessionPanel.dataset.state = String(completedStatus);
      setSessionCopy(completedStatus);
      setStatus(completedStatus === "authorised" ? "sessionCompleted" : "sessionReviewPending", completedStatus === "authorised" ? "ok" : "idle");
    };
    const renderCapabilityCheck = (check: CapabilityCheck) => {
      lastCapabilityCheck = check;
      const locale = document.documentElement.dataset.locale === "zh" ? "zh-CN" : "en-GB";
      if (capabilityCheckStatus) capabilityCheckStatus.textContent = message(`capabilityStatus${check.status[0]?.toUpperCase()}${check.status.slice(1)}`);
      if (capabilityCheckExpiry) capabilityCheckExpiry.textContent = new Intl.DateTimeFormat(locale, { dateStyle: "medium", timeStyle: "short" }).format(new Date(check.expires_at));
      if (capabilityCheckNamespace) {
        const ownership = check.namespace.owned_by_capability_principal ? message("capabilityOwnerMatch") : message("capabilityOwnerMismatch");
        capabilityCheckNamespace.textContent = `${check.namespace.name} · ${check.namespace.status} · ${ownership}`;
      }
      if (capabilityCheckScopes) capabilityCheckScopes.textContent = check.scopes.join(" · ");
      if (capabilityCheckSummary) capabilityCheckSummary.hidden = false;
    };
    const checkCapabilityKey = async (rawKeyId: string, successKey: string) => {
      const keyId = rawKeyId.trim().toLowerCase();
      if (!/^cap_[0-9a-f]{32}$/.test(keyId)) throw new WorkflowError("errorCapabilityKeyId");
      if (!coordinateValid()) throw new WorkflowError("invalidCoordinate");
      setStatus("checkingCapability");
      clearCapabilityConfirmation();
      const query = new URLSearchParams({ namespace: fieldValue("namespace"), name: fieldValue("name") });
      const timeout = new AbortController();
      const relayAbort = () => timeout.abort();
      const timer = window.setTimeout(() => timeout.abort(), 10_000);
      signal.addEventListener("abort", relayAbort, { once: true });
      let response: Response;
      try {
        response = await fetch(`${signerRoot?.dataset.apiOrigin}/v1/capabilities/${encodeURIComponent(keyId)}/check?${query}`, {
          signal: timeout.signal,
          headers: { accept: "application/json" },
        });
      } catch (error) {
        if (timeout.signal.aborted && !signal.aborted) throw new WorkflowError("errorCapabilityCheckTimeout");
        throw error;
      } finally {
        window.clearTimeout(timer);
        signal.removeEventListener("abort", relayAbort);
      }
      const parsed = await readApiResponse(response);
      if (!response.ok) throw new WorkflowError("errorCapabilityCheck", JSON.stringify({ status: response.status, response: parsed }, null, 2));
      if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) throw new WorkflowError("errorCapabilityCheckResponse");
      const check = parsed as Partial<CapabilityCheck>;
      if (
        check.key_id !== keyId
        || !Array.isArray(check.scopes)
        || typeof check.expires_at !== "string"
        || !check.namespace
        || !check.allows
        || typeof check.usable_for_publish !== "boolean"
        || !Array.isArray(check.reasons)
      ) throw new WorkflowError("errorCapabilityCheckResponse");
      renderCapabilityCheck(check as CapabilityCheck);
      if (!check.usable_for_publish) {
        throw new WorkflowError("errorCapabilityNotUsable", JSON.stringify({ reasons: check.reasons }, null, 2));
      }
      confirmedCapabilityKeyId = keyId;
      setStatus(successKey, "ok");
      syncWorkflow();
    };
    const submitCapability = async () => {
      const payload = parsePayload();
      const signature = await signatureForPayload(payload);
      const response = await fetch(`${signerRoot?.dataset.apiOrigin}/v1/capabilities`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ payload, wallet_signature: signature }),
        signal,
      });
      const parsed = await readApiResponse(response);
      if (!response.ok) throw new WorkflowError("errorCapabilityRejected", JSON.stringify({ status: response.status, response: parsed }, null, 2));
      if (!parsed || typeof parsed !== "object" || Array.isArray(parsed) || typeof (parsed as Record<string, unknown>).key_id !== "string") {
        throw new WorkflowError("errorCapabilityCheckResponse");
      }
      const keyId = String((parsed as Record<string, unknown>).key_id).trim().toLowerCase();
      if (!/^cap_[0-9a-f]{32}$/.test(keyId)) throw new WorkflowError("errorCapabilityCheckResponse");
      capabilitySubmitted = true;
      submittedCapabilityKeyId = keyId;
      setStatus("submitted", "ok");
    };
    const claimNamespace = async () => {
      const namespace = fieldValue("namespace");
      const name = fieldValue("name");
      if (!namespace) throw new WorkflowError("errorNamespaceRequired");
      const payload = parsePayload();
      const scopes = Array.isArray(payload.requested_scopes) ? payload.requested_scopes.filter((scope): scope is string => typeof scope === "string") : [];
      if (!scopes.includes(`publish:${namespace}/${name}`) && !scopes.includes(`publish:${namespace}/*`)) {
        throw new WorkflowError("errorScope");
      }
      const signature = await signatureForPayload(payload);
      const response = await fetch(`${signerRoot?.dataset.apiOrigin}/v1/namespaces/claim`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ namespace, payload, wallet_signature: signature }),
        signal,
      });
      const parsed = await readApiResponse(response);
      if (!response.ok) throw new WorkflowError("errorClaimRejected", JSON.stringify({ status: response.status, response: parsed }, null, 2));
      const claimStatus = parsed && typeof parsed === "object" && !Array.isArray(parsed)
        ? (parsed as Record<string, unknown>).status
        : undefined;
      if (claimStatus !== "active") {
        namespaceClaimed = false;
        namespaceReviewPending = true;
        setStatus("namespaceReviewPending", "idle");
        return;
      }
      namespaceClaimed = true;
      namespaceReviewPending = false;
      await checkCapabilityKey(submittedCapabilityKeyId, "capabilityConfirmed");
    };

    for (const button of capabilityActionButtons) {
      button.addEventListener("click", () => {
        void (async () => {
          busy = true;
          clearTechnical();
          syncWorkflow();
          const action = button.dataset.capabilityAction;
          try {
            if (!coordinateValid()) throw new WorkflowError("invalidCoordinate");
            if (authorisationMode !== "new") throw new WorkflowError("chooseAuthorisationPath");
            if (action === "connect") {
              await ensureWalletSigner();
            } else if (action === "sign") {
              if (authorisationSessionMode) {
                await prepareAuthorisationSessionChallenge();
                writeSignature(await signCapabilityPayload());
                setStatus("signed", "ok");
                await completeAuthorisationSession();
              } else {
                parsePayload();
                writeSignature(await signCapabilityPayload());
                setStatus("signed", "ok");
              }
            } else if (action === "submit") {
              await submitCapability();
            } else if (action === "claim") {
              await claimNamespace();
            }
          } catch (error) {
            let recovered = false;
            if (authorisationSessionMode && action === "sign") {
              try {
                await loadAuthorisationSession();
                recovered = authorisationSessionFinished;
              } catch {
                // Keep the original signing or submission error.
              }
              if (!recovered) clearSignature();
            }
            const fallback = action === "connect"
              ? "errorWallet"
              : action === "sign"
                ? "errorSigning"
                : action === "submit"
                  ? "errorSubmit"
                  : "errorClaim";
            if (!recovered) setError(error, fallback);
          } finally {
            busy = false;
            syncWorkflow();
          }
        })();
      }, { signal });
    }
    for (const button of changeWalletButtons) {
      button.addEventListener("click", () => {
        void (async () => {
          busy = true;
          syncWorkflow();
          try {
            await resetWallet(true);
            await ensureWalletSigner();
          } catch (error) {
            setError(error, "errorWallet");
          } finally {
            busy = false;
            syncWorkflow();
          }
        })();
      }, { signal });
    }
    openManualPublish?.addEventListener("click", () => {
      if (publishEntry) publishEntry.hidden = true;
      if (manualPublish) manualPublish.hidden = false;
      closeManualPublish?.focus({ preventScroll: true });
      manualPublish?.scrollIntoView({ behavior: preferredScrollBehavior, block: "start" });
    }, { signal });
    closeManualPublish?.addEventListener("click", () => {
      if (manualPublish) manualPublish.hidden = true;
      if (publishEntry) publishEntry.hidden = false;
      publishEntry?.scrollIntoView({ behavior: preferredScrollBehavior, block: "start" });
      openManualPublish?.focus({ preventScroll: true });
    }, { signal });
    sessionRetry?.addEventListener("click", () => {
      void (async () => {
        if (sessionPanel) sessionPanel.dataset.state = "loading";
        setSessionCopy("pending");
        setStatus("sessionLoading");
        sessionRetry.disabled = true;
        try {
          await loadAuthorisationSession();
        } catch (error) {
          if (sessionPanel) sessionPanel.dataset.state = "error";
          setSessionCopy("error");
          setError(error, "errorSessionLoad");
        } finally {
          sessionRetry.disabled = false;
          syncWorkflow();
        }
      })();
    }, { signal });
    for (const button of authorisationModes) {
      button.addEventListener("click", () => {
        if (!coordinateValid()) {
          coordinateError?.removeAttribute("hidden");
          (namespaceInput?.validity.valid ? nameInput : namespaceInput)?.focus();
          setStatus("invalidCoordinate", "error");
          return;
        }
        authorisationMode = button.dataset.authorisationMode === "existing" ? "existing" : "new";
        clearTechnical();
        if (confirmedCapabilityKeyId) setStatus("capabilityConfirmed", "ok");
        else if (authorisationMode === "existing") setStatus("existingCapabilityIdle");
        else if (activeWalletSigner || activeExternalWallet) setStatus(activeExternalWallet ? "walletExternalReady" : "walletConnected", "ok");
        else setStatus("walletIdle");
        syncWorkflow();
        if (authorisationMode === "existing") existingCapabilityKey?.focus();
      }, { signal });
    }
    existingCapabilityCheck?.addEventListener("click", () => {
      void (async () => {
        busy = true;
        clearTechnical();
        syncWorkflow();
        try {
          await checkCapabilityKey(existingCapabilityKey?.value ?? "", "existingCapabilityConfirmed");
        } catch (error) {
          setError(error, "errorCapabilityCheck");
        } finally {
          busy = false;
          syncWorkflow();
        }
      })();
    }, { signal });
    walletClose?.addEventListener("click", () => walletDialog?.close(), { signal });
    walletBack?.addEventListener("click", renderWalletChoices, { signal });
    walletDialog?.addEventListener("close", () => {
      const picker = walletPicker;
      if (picker && !picker.settled) {
        picker.settled = true;
        picker.reject(new WorkflowError("errorNoWallet"));
      }
      walletPicker = null;
    }, { signal });
    existingCapabilityKey?.addEventListener("input", () => {
      if (existingCapabilityKey.value.trim().toLowerCase() !== confirmedCapabilityKeyId) clearCapabilityConfirmation();
      clearTechnical();
      setStatus("existingCapabilityIdle");
      syncWorkflow();
    }, { signal });
    payloadInput?.addEventListener("input", () => {
      syncExternalPrincipal();
      clearSignature();
      clearTechnical();
      syncWorkflow();
    }, { signal });
    signatureOutput?.addEventListener("input", () => {
      if (!activeExternalWallet) return;
      capabilitySubmitted = false;
      submittedCapabilityKeyId = "";
      namespaceClaimed = false;
      namespaceReviewPending = false;
      clearCapabilityConfirmation();
      clearTechnical();
      syncWorkflow();
    }, { signal });
    form?.addEventListener("input", (event) => {
      const coordinate = `${fieldValue("namespace")}/${fieldValue("name")}`;
      if (lastCoordinate && coordinate !== lastCoordinate && event.target !== pathInput) {
        clearSignature();
        if (authorisationMode === "existing") setStatus("existingCapabilityIdle");
      }
      lastCoordinate = coordinate;
      syncArtifactKind();
      syncWorkflow();
    }, { signal });
    pathInput?.addEventListener("input", syncWorkflow, { signal });
    window.addEventListener("cellscript:locale-change", () => {
      setStatus(statusKey, statusTone, statusSuffix);
      if (lastCapabilityCheck) renderCapabilityCheck(lastCapabilityCheck);
      if (authorisationSession && sessionKind) sessionKind.textContent = artifactKindLabel(authorisationSession.artifact.kind);
      if (walletDialog?.open) renderWalletChoices();
      syncArtifactKind();
      syncWorkflow();
    }, { signal });
    document.addEventListener("astro:before-swap", () => {
      if (walletPicker && !walletPicker.settled) {
        walletPicker.settled = true;
        walletPicker.reject(new WorkflowError("errorNoWallet"));
      }
      walletDialog?.close();
      walletController?.disconnect?.();
      lifecycle.abort();
    }, { once: true });

    lastCoordinate = `${fieldValue("namespace")}/${fieldValue("name")}`;
    syncArtifactKind();
    syncWorkflow();
    if (authorisationSessionMode) {
      void loadAuthorisationSession().catch((error) => {
        if (sessionPanel) sessionPanel.dataset.state = "error";
        setSessionCopy("error");
        setError(error, "errorSessionLoad");
        syncWorkflow();
      });
    }
  </script>
</RegistryLayout>
