---
import RegistryLayout from "../../layouts/RegistryLayout.astro";
import { defaultLocale, translations } from "../../i18n/translations";
import { registryRuntime } from "../../lib/registry-runtime";

const t = translations[defaultLocale];
const description = t.registry.submit.description;
const apiOrigin = registryRuntime.apiOrigin;
---

<RegistryLayout title="CellScript Artifact Registry: Publish" description={description} headingKey="registry.shellTitle" descriptionKey="registry.shellDescription" active="submit" showSubmitCta={false}>
  <section class="registry-flow" aria-label={t.registry.nav.submit} data-i18n-aria-label="registry.nav.submit">
    <section class="registry-publish-entry" data-publish-entry aria-labelledby="registry-publish-entry-title">
      <div class="registry-publish-entry-main">
        <p class="registry-context-label" data-i18n="registry.submit.entryLabel">{t.registry.submit.entryLabel}</p>
        <h2 id="registry-publish-entry-title" data-i18n="registry.submit.entryTitle">{t.registry.submit.entryTitle}</h2>
        <p class="registry-publish-entry-lead" data-i18n="registry.submit.entryBody">{t.registry.submit.entryBody}</p>
        <div class="registry-publish-command" aria-label={t.registry.submit.entryCommandLabel} data-i18n-aria-label="registry.submit.entryCommandLabel">
          <span>
            <small data-i18n="registry.submit.entryCommandLabel">{t.registry.submit.entryCommandLabel}</small>
            <code><i aria-hidden="true">$</i><span>cellc publish --authorise</span></code>
          </span>
          <button class="registry-button primary" type="button" data-copy-text="cellc publish --authorise" data-revert-label={t.registry.submit.entryCopyCommand} data-i18n="registry.submit.entryCopyCommand">{t.registry.submit.entryCopyCommand}</button>
        </div>
        <p class="registry-publish-entry-note">
          <span class="registry-assurance-mark" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none">
              <path d="m4 8.25 2.35 2.35L12.25 4.7" />
            </svg>
          </span>
          <span data-i18n="registry.submit.entryNote">{t.registry.submit.entryNote}</span>
        </p>
        <button class="registry-text-button registry-publish-advanced" type="button" data-open-manual-publish data-i18n="registry.submit.entryAdvanced">{t.registry.submit.entryAdvanced}</button>
      </div>
      <aside class="registry-publish-journey" aria-label={t.registry.submit.entryJourneyLabel} data-i18n-aria-label="registry.submit.entryJourneyLabel">
        <p class="registry-label" data-i18n="registry.submit.entryJourneyLabel">{t.registry.submit.entryJourneyLabel}</p>
        <ol>
          <li><span aria-hidden="true"></span><div><strong data-i18n="registry.submit.entryStepCheck">{t.registry.submit.entryStepCheck}</strong><small data-i18n="registry.submit.entryStepCheckBody">{t.registry.submit.entryStepCheckBody}</small></div></li>
          <li><span aria-hidden="true"></span><div><strong data-i18n="registry.submit.entryStepApprove">{t.registry.submit.entryStepApprove}</strong><small data-i18n="registry.submit.entryStepApproveBody">{t.registry.submit.entryStepApproveBody}</small></div></li>
          <li><span aria-hidden="true"></span><div><strong data-i18n="registry.submit.entryStepPublish">{t.registry.submit.entryStepPublish}</strong><small data-i18n="registry.submit.entryStepPublishBody">{t.registry.submit.entryStepPublishBody}</small></div></li>
        </ol>
      </aside>
    </section>

    <section class="registry-session-approval" data-authorisation-session data-state="loading" hidden aria-labelledby="registry-authorisation-session-title">
      <div class="registry-session-main">
        <p class="registry-label" data-i18n="registry.submit.sessionLabel">{t.registry.submit.sessionLabel}</p>
        <h2 id="registry-authorisation-session-title">
          <span data-session-title data-i18n="registry.submit.sessionApprovalTitle">{t.registry.submit.sessionApprovalTitle}</span>
          <strong data-session-coordinate aria-live="polite">—</strong>
        </h2>
        <p class="registry-session-lead" data-session-lead data-i18n="registry.submit.sessionApprovalBody">{t.registry.submit.sessionApprovalBody}</p>
        <dl class="registry-session-facts">
          <div><dt data-i18n="registry.submit.sessionArtifactType">{t.registry.submit.sessionArtifactType}</dt><dd data-session-kind>—</dd></div>
          <div><dt data-i18n="registry.submit.sessionPermission">{t.registry.submit.sessionPermission}</dt><dd data-i18n="registry.submit.sessionPermissionBody">{t.registry.submit.sessionPermissionBody}</dd></div>
        </dl>
        <div class="registry-session-action" data-session-action>
          <output class="registry-signer-status" data-capability-status role="status" aria-live="polite" data-i18n="registry.submit.sessionLoading">{t.registry.submit.sessionLoading}</output>
          <div class="registry-session-buttons">
            <button class="registry-button primary" type="button" data-capability-action="connect" data-i18n="registry.submit.continueConnect" hidden>{t.registry.submit.continueConnect}</button>
            <button class="registry-button primary" type="button" data-capability-action="sign" data-i18n="registry.submit.continueSubmit" hidden>{t.registry.submit.continueSubmit}</button>
            <button class="registry-text-button registry-change-wallet" type="button" data-capability-change-wallet hidden data-i18n="registry.submit.changeWallet">{t.registry.submit.changeWallet}</button>
          </div>
        </div>
        <div class="registry-session-recovery">
          <p data-i18n="registry.submit.sessionRecoveryBody">{t.registry.submit.sessionRecoveryBody}</p>
          <div>
            <button class="registry-button" type="button" data-session-retry data-i18n="registry.submit.sessionRetry">{t.registry.submit.sessionRetry}</button>
            <button class="registry-copy" type="button" data-copy-text="cellc publish --authorise" data-revert-label={t.registry.submit.entryCopyCommand} data-i18n="registry.submit.entryCopyCommand">{t.registry.submit.entryCopyCommand}</button>
          </div>
        </div>
        <details class="registry-session-details">
          <summary data-i18n="registry.submit.technicalDetails">{t.registry.submit.technicalDetails}</summary>
          <dl>
            <div><dt data-i18n="registry.submit.sessionAccess">{t.registry.submit.sessionAccess}</dt><dd data-session-scope>—</dd></div>
            <div><dt data-i18n="registry.submit.sessionExpires">{t.registry.submit.sessionExpires}</dt><dd data-session-expiry>—</dd></div>
            <div><dt data-i18n="registry.submit.sessionId">{t.registry.submit.sessionId}</dt><dd data-session-id>—</dd></div>
          </dl>
        </details>
      </div>
      <aside class="registry-session-journey" aria-label={t.registry.submit.sessionJourneyLabel} data-i18n-aria-label="registry.submit.sessionJourneyLabel">
        <span class="registry-network-badge"><i aria-hidden="true"></i>CKB {registryRuntime.network}</span>
        <ol>
          <li data-session-stage="local" data-state="complete"><span>01</span><div><strong data-i18n="registry.submit.sessionStepLocal">{t.registry.submit.sessionStepLocal}</strong><small data-session-stage-state data-i18n="registry.submit.sessionStepComplete">{t.registry.submit.sessionStepComplete}</small></div></li>
          <li data-session-stage="approval" data-state="active"><span>02</span><div><strong data-i18n="registry.submit.sessionStepApproval">{t.registry.submit.sessionStepApproval}</strong><small data-session-stage-state data-i18n="registry.submit.sessionStepCurrent">{t.registry.submit.sessionStepCurrent}</small></div></li>
          <li data-session-stage="publish" data-state="pending"><span>03</span><div><strong data-i18n="registry.submit.sessionStepPublish">{t.registry.submit.sessionStepPublish}</strong><small data-session-stage-state data-i18n="registry.submit.sessionStepNext">{t.registry.submit.sessionStepNext}</small></div></li>
        </ol>
      </aside>
    </section>

    <section class="registry-manual-publish" data-manual-publish hidden aria-labelledby="registry-manual-publish-title">
      <header class="registry-manual-publish-head">
        <button class="registry-text-button" type="button" data-close-manual-publish data-i18n="registry.submit.manualBack">{t.registry.submit.manualBack}</button>
        <div class="registry-manual-publish-intro">
          <p class="registry-context-label" data-i18n="registry.submit.manualLabel">{t.registry.submit.manualLabel}</p>
          <h2 id="registry-manual-publish-title" data-i18n="registry.submit.manualTitle">{t.registry.submit.manualTitle}</h2>
          <p data-i18n="registry.submit.manualBody">{t.registry.submit.manualBody}</p>
        </div>
        <aside class="registry-submit-boundary" aria-label={t.registry.submit.toolBoundaryTitle}>
          <strong data-i18n="registry.submit.toolBoundaryTitle">{t.registry.submit.toolBoundaryTitle}</strong>
          <span data-i18n="registry.submit.toolBoundaryBody">{t.registry.submit.toolBoundaryBody}</span>
        </aside>
      </header>

      <nav class="registry-manual-index" aria-label={t.registry.submit.manualLabel}>
        <ol>
          <li><a href="#registry-submit-form"><span aria-hidden="true">1</span><strong data-i18n="registry.submit.detailsLabel">{t.registry.submit.detailsLabel}</strong></a></li>
          <li><a href="#registry-preflight-stage"><span aria-hidden="true">2</span><strong data-i18n="registry.submit.preflightTitle">{t.registry.submit.preflightTitle}</strong></a></li>
          <li><a href="#registry-authorisation-stage"><span aria-hidden="true">3</span><strong data-i18n="registry.submit.walletLabel">{t.registry.submit.walletLabel}</strong></a></li>
        </ol>
      </nav>

    <form class="registry-builder" id="registry-submit-form" data-submit-form novalidate>
      <div class="registry-builder-heading">
        <p class="registry-label" data-i18n="registry.submit.detailsLabel">{t.registry.submit.detailsLabel}</p>
        <h2 data-i18n="registry.submit.detailsTitle">{t.registry.submit.detailsTitle}</h2>
        <p data-i18n="registry.submit.detailsBody">{t.registry.submit.detailsBody}</p>
      </div>
      <div class="registry-builder-grid registry-builder-grid-compact">
        <label class="registry-builder-field registry-artifact-kind-field">
          <span data-i18n="registry.submit.artifactKind">{t.registry.submit.artifactKind}</span>
          <select class="registry-select" name="artifact_kind" data-artifact-kind>
            <option value="source_library" data-i18n="registry.submit.kindCellScript">{t.registry.submit.kindCellScript}</option>
            <option value="profile_library" data-i18n="registry.submit.kindProfileLibrary">{t.registry.submit.kindProfileLibrary}</option>
            <option value="deployable_contract" data-i18n="registry.submit.kindCkbScript">{t.registry.submit.kindCkbScript}</option>
            <option value="runtime_verifier" data-i18n="registry.submit.kindRuntimeVerifier">{t.registry.submit.kindRuntimeVerifier}</option>
            <option value="reproducible_binary" data-i18n="registry.submit.kindReproducibleBinary">{t.registry.submit.kindReproducibleBinary}</option>
            <option value="template" data-i18n="registry.submit.kindTemplate">{t.registry.submit.kindTemplate}</option>
          </select>
          <small class="registry-field-hint" data-artifact-kind-hint data-i18n="registry.submit.kindCellScriptHint">{t.registry.submit.kindCellScriptHint}</small>
        </label>
        <label class="registry-builder-field" data-artifact-language-field>
          <span data-i18n="registry.submit.artifactLanguage">{t.registry.submit.artifactLanguage}</span>
          <select class="registry-select" name="artifact_language" data-artifact-language>
            <option value="cellscript">CellScript</option>
            <option value="rust">Rust</option>
            <option value="c">C</option>
            <option value="javascript">JavaScript</option>
            <option value="other">Other</option>
            <option value="unspecified">Unspecified</option>
          </select>
          <small class="registry-field-hint" data-i18n="registry.submit.artifactLanguageHint">{t.registry.submit.artifactLanguageHint}</small>
        </label>
      </div>
      <div class="registry-builder-grid registry-builder-grid-compact">
        <label class="registry-builder-field">
          <span data-i18n="registry.submit.namespace">{t.registry.submit.namespace}</span>
          <input
            class="registry-input"
            name="namespace"
            placeholder="dob"
            autocomplete="off"
            required
            minlength="1"
            maxlength="64"
            pattern="[a-z0-9](?:(?:[a-z0-9_]|-){0,62}[a-z0-9])?"
            aria-describedby="submit-coordinate-help submit-coordinate-error"
          />
        </label>
        <label class="registry-builder-field">
          <span data-i18n="registry.submit.packageName">{t.registry.submit.packageName}</span>
          <input
            class="registry-input"
            name="name"
            placeholder="evolving-dob-profile-v1"
            autocomplete="off"
            required
            minlength="1"
            maxlength="64"
            pattern="[a-z0-9](?:(?:[a-z0-9_]|-){0,62}[a-z0-9])?"
            aria-describedby="submit-coordinate-help submit-coordinate-error"
          />
        </label>
      </div>
      <p class="registry-field-hint" id="submit-coordinate-help" data-i18n="registry.submit.coordinateHelp">{t.registry.submit.coordinateHelp}</p>
      <p class="registry-field-error" id="submit-coordinate-error" data-coordinate-error hidden data-i18n="registry.submit.invalidCoordinate">{t.registry.submit.invalidCoordinate}</p>
      <details class="registry-command-options registry-profile-builder" data-profile-builder hidden>
        <summary data-i18n="registry.submit.profileContractTitle">{t.registry.submit.profileContractTitle}</summary>
        <p class="registry-field-hint" data-i18n="registry.submit.profileContractBody">{t.registry.submit.profileContractBody}</p>
        <div class="registry-builder-grid registry-builder-grid-compact" data-profile-group="identity">
          <label class="registry-builder-field"><span data-i18n="registry.submit.release">{t.registry.submit.release}</span><input class="registry-input" name="artifact_release" placeholder="1.0.0" pattern="[0-9]+[.][0-9]+[.][0-9]+(?:(?:-|[+])(?:[0-9A-Za-z.]|-)+)?" /></label>
        </div>
        <div class="registry-builder-grid registry-builder-grid-compact" data-profile-group="build">
          <label class="registry-builder-field"><span data-i18n="registry.submit.buildTarget">{t.registry.submit.buildTarget}</span><input class="registry-input" name="build_target" value="riscv64imac-unknown-none-elf" /></label>
          <label class="registry-builder-field"><span data-i18n="registry.submit.toolchain">{t.registry.submit.toolchain}</span><input class="registry-input" name="toolchain" placeholder="rustc 1.97.1" /></label>
          <label class="registry-builder-field"><span data-i18n="registry.submit.sourceRevision">{t.registry.submit.sourceRevision}</span><input class="registry-input" name="source_revision" placeholder="git commit / source digest" /></label>
          <label class="registry-builder-field"><span data-i18n="registry.submit.reproducibleBuild">{t.registry.submit.reproducibleBuild}</span><select class="registry-select" name="build_reproducible"><option value="false" data-i18n="registry.submit.notReproducible">{t.registry.submit.notReproducible}</option><option value="true" data-i18n="registry.submit.reproducible">{t.registry.submit.reproducible}</option></select></label>
          <label class="registry-builder-field"><span data-i18n="registry.submit.securityStatus">{t.registry.submit.securityStatus}</span><select class="registry-select" name="security_status"><option value="unaudited">unaudited</option><option value="review_required" selected>review required</option><option value="audited">audited</option><option value="rejected">rejected</option></select></label>
        </div>
        <div class="registry-builder-grid registry-builder-grid-compact" data-profile-group="ckb">
          <label class="registry-builder-field"><span data-i18n="registry.submit.scriptRole">{t.registry.submit.scriptRole}</span><select class="registry-select" name="script_role"><option value="type">type</option><option value="lock">lock</option><option value="dual_role">dual role</option><option value="helper">helper</option></select></label>
          <label class="registry-builder-field"><span data-i18n="registry.submit.vmVersion">{t.registry.submit.vmVersion}</span><select class="registry-select" name="vm_version"><option value="2">2</option><option value="1">1</option><option value="0">0</option></select></label>
          <label class="registry-builder-field"><span>hash_type</span><select class="registry-select" name="hash_type"><option value="data1">data1</option><option value="data2">data2</option><option value="data">data</option><option value="type">type</option></select></label>
          <label class="registry-builder-field"><span>dep_type</span><select class="registry-select" name="dep_type"><option value="code">code</option><option value="dep_group">dep_group</option></select></label>
        </div>
        <div class="registry-builder-grid registry-builder-grid-compact" data-profile-group="verifier">
          <label class="registry-builder-field"><span data-i18n="registry.submit.verifierId">{t.registry.submit.verifierId}</span><input class="registry-input" name="verifier_id" placeholder="btc.bip340.v0" /></label>
          <label class="registry-builder-field"><span data-i18n="registry.submit.ipcAbi">{t.registry.submit.ipcAbi}</span><input class="registry-input" name="ipc_abi" placeholder="cellscript-btc-bip340-ipc-v0" /></label>
        </div>
        <div class="registry-builder-grid registry-builder-grid-compact" data-profile-group="reproduction">
          <label class="registry-builder-field"><span data-i18n="registry.submit.buildEnvironment">{t.registry.submit.buildEnvironment}</span><input class="registry-input" name="build_environment" placeholder="container image@sha256:digest" /></label>
          <label class="registry-builder-field"><span data-i18n="registry.submit.buildCommand">{t.registry.submit.buildCommand}</span><input class="registry-input" name="build_command" placeholder="cargo build --locked --release" /></label>
        </div>
        <div class="registry-builder-grid registry-builder-grid-compact" data-profile-group="copy">
          <label class="registry-builder-field"><span data-i18n="registry.submit.templateEntrypoint">{t.registry.submit.templateEntrypoint}</span><input class="registry-input" name="template_entrypoint" placeholder="src/main.cell" /></label>
        </div>
        <div class="registry-step-code registry-profile-preview">
          <span class="registry-label">Artifact.toml</span>
          <code data-artifact-manifest-preview></code>
          <button class="registry-copy" type="button" data-artifact-manifest-copy data-copy-text="" data-revert-label={t.registry.copy} data-i18n="registry.copy">{t.registry.copy}</button>
        </div>
        <div class="registry-step-code registry-profile-preview">
          <span class="registry-label">artifact.bundle.json</span>
          <code data-profile-contract-preview></code>
          <button class="registry-copy" type="button" data-artifact-bundle-copy data-copy-text="" data-revert-label={t.registry.copy} data-i18n="registry.copy">{t.registry.copy}</button>
        </div>
      </details>
    </form>

    <section class="registry-submit-preflight" id="registry-preflight-stage" aria-labelledby="registry-preflight-heading">
      <div class="registry-step-copy">
        <h2 id="registry-preflight-heading" data-i18n="registry.submit.preflightTitle">{t.registry.submit.preflightTitle}</h2>
        <p data-i18n="registry.submit.preflightBody">{t.registry.submit.preflightBody}</p>
      </div>
      <div class="registry-step-code">
        <code data-submit-preflight>cellc package verify --json &amp;&amp; cellc publish --dry-run</code>
        <button class="registry-copy" type="button" data-submit-preflight-copy data-copy-text="cellc package verify --json && cellc publish --dry-run" data-revert-label={t.registry.copy} data-i18n="registry.copy">{t.registry.copy}</button>
        <details class="registry-command-options">
          <summary data-i18n="registry.submit.localCommandOptions">{t.registry.submit.localCommandOptions}</summary>
          <label class="registry-builder-field">
            <span data-i18n="registry.submit.packageDir">{t.registry.submit.packageDir}</span>
            <input class="registry-input" name="path" form="registry-submit-form" placeholder="./path/to/package" autocomplete="off" />
          </label>
        </details>
      </div>
    </section>

    <section class="registry-authorisation-card" id="registry-authorisation-stage" data-authorisation-card aria-labelledby="registry-wallet-heading">
      <header class="registry-authorisation-head">
        <div>
          <h2 id="registry-wallet-heading" data-i18n="registry.submit.walletTitle">{t.registry.submit.walletTitle}</h2>
          <p data-i18n="registry.submit.walletBody">{t.registry.submit.walletBody}</p>
        </div>
        <div class="registry-authorisation-controls">
          <span class="registry-network-badge"><i aria-hidden="true"></i>CKB {registryRuntime.network}</span>
          <output class="registry-signer-status" data-capability-status role="status" aria-live="polite" data-i18n="registry.submit.authorisationIdle">{t.registry.submit.authorisationIdle}</output>
          <div class="registry-signer-actions">
            <button class="registry-text-button registry-change-wallet" type="button" data-capability-change-wallet hidden data-i18n="registry.submit.changeWallet">{t.registry.submit.changeWallet}</button>
          </div>
        </div>
      </header>

      <div class="registry-authorisation-paths" role="group" aria-label={t.registry.submit.authorisationPathLabel} data-i18n-aria-label="registry.submit.authorisationPathLabel">
        <button type="button" data-authorisation-mode="new" aria-pressed="false">
          <span data-i18n="registry.submit.newCapabilityTitle">{t.registry.submit.newCapabilityTitle}</span>
          <small data-i18n="registry.submit.newCapabilityBody">{t.registry.submit.newCapabilityBody}</small>
        </button>
        <button type="button" data-authorisation-mode="existing" aria-pressed="false">
          <span data-i18n="registry.submit.existingCapabilityTitle">{t.registry.submit.existingCapabilityTitle}</span>
          <small data-i18n="registry.submit.existingCapabilityBody">{t.registry.submit.existingCapabilityBody}</small>
        </button>
      </div>

      <div class="registry-signer" data-capability-signer data-new-capability-flow data-api-origin={apiOrigin} hidden>
        <ol class="registry-authorisation-progress" aria-label={t.registry.submit.progressLabel} data-i18n-aria-label="registry.submit.progressLabel">
          <li data-workflow-stage="wallet"><span>01</span><strong data-i18n="registry.submit.stageConnect">{t.registry.submit.stageConnect}</strong></li>
          <li data-workflow-stage="scope"><span>02</span><strong data-i18n="registry.submit.stageScope">{t.registry.submit.stageScope}</strong></li>
          <li data-workflow-stage="authorise"><span>03</span><strong data-i18n="registry.submit.stageAuthorise">{t.registry.submit.stageAuthorise}</strong></li>
        </ol>
        <div class="registry-workflow-guide" data-workflow-guide data-state="active" role="status" aria-live="polite" aria-atomic="true">
          <span data-workflow-guide-index>01</span>
          <div>
            <strong data-workflow-guide-title data-i18n="registry.submit.guideChooseRouteTitle">{t.registry.submit.guideChooseRouteTitle}</strong>
            <p data-workflow-guide-body data-i18n="registry.submit.guideChooseRouteBody">{t.registry.submit.guideChooseRouteBody}</p>
          </div>
        </div>

        <label class="registry-builder-field registry-signer-principal" data-principal-panel hidden>
          <span data-i18n="registry.submit.principal">{t.registry.submit.principal}</span>
          <span class="registry-inline-control">
            <input
              class="registry-input"
              data-capability-principal
              readonly
              placeholder={t.registry.submit.principalPlaceholder}
              data-i18n-placeholder="registry.submit.principalPlaceholder"
            />
            <button class="registry-copy" type="button" data-capability-copy-principal data-copy-text="" data-revert-label={t.registry.submit.copyPrincipal} data-i18n="registry.submit.copyPrincipal">{t.registry.submit.copyPrincipal}</button>
          </span>
        </label>

        <div class="registry-progressive-panel" data-payload-panel hidden>
          <div class="registry-capability-create-intro">
            <strong data-i18n="registry.submit.createLocalKeyTitle">{t.registry.submit.createLocalKeyTitle}</strong>
            <span data-i18n="registry.submit.createLocalKeyBody">{t.registry.submit.createLocalKeyBody}</span>
          </div>
          <div class="registry-step-code registry-capability-command">
            <code data-submit-create-capability>cellc auth capability create --principal-type &lt;principal_type&gt; --principal-id &lt;principal_id&gt; --scope publish:&lt;namespace&gt;/&lt;name&gt; --expires 90d --json &gt; capability-payload.json</code>
            <button class="registry-copy" type="button" data-submit-create-capability-copy data-copy-text="" data-revert-label={t.registry.submit.copyCreateCommand} data-i18n="registry.submit.copyCreateCommand">{t.registry.submit.copyCreateCommand}</button>
          </div>
          <label class="registry-builder-field">
            <span data-i18n="registry.submit.payload">{t.registry.submit.payload}</span>
            <textarea
              class="registry-textarea"
              data-capability-payload
              spellcheck="false"
              placeholder={t.registry.submit.payloadPlaceholder}
              data-i18n-placeholder="registry.submit.payloadPlaceholder"
              aria-describedby="capability-payload-hint"
            ></textarea>
            <small class="registry-field-hint" id="capability-payload-hint" data-i18n="registry.submit.payloadHint">{t.registry.submit.payloadHint}</small>
          </label>
        </div>

        <div class="registry-progressive-panel" data-signature-panel hidden>
          <label class="registry-builder-field">
            <span data-i18n="registry.submit.signature">{t.registry.submit.signature}</span>
