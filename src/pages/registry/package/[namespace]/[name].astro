---
import RegistryPackageDetail from "../../../../components/RegistryPackageDetail.astro";
import RegistryLayout from "../../../../layouts/RegistryLayout.astro";
import { registryPackages, toRegistryPackageView, type RegistryPackage } from "../../../../lib/registry";

export function getStaticPaths() {
  return registryPackages.map((pkg) => ({
    params: { namespace: pkg.namespace, name: pkg.name },
    props: { pkg },
  }));
}

interface Props {
  pkg: RegistryPackage;
}

const { pkg } = Astro.props;
const description = pkg.description || `CellScript registry package ${pkg.coordinate}`;
---

<RegistryLayout
  title={`CellScript Registry: ${pkg.coordinate}`}
  description={description}
  active="package"
  showHeader={false}
>
  <RegistryPackageDetail pkg={toRegistryPackageView(pkg)} />
</RegistryLayout>
