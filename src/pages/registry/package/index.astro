---
import RegistryLayout from "../../../layouts/RegistryLayout.astro";
import { defaultLocale, translations } from "../../../i18n/translations";

const t = translations[defaultLocale];
const apiOrigin = (import.meta.env.PUBLIC_REGISTRY_API_ORIGIN || "https://api.registry.cellscript.dev").replace(/\/$/, "");
---

<RegistryLayout
  title="CellScript Registry: Package"
  description={t.registry.package.liveDescription}
  active="package"
>
  <section class="registry-live-package" data-live-package data-api-origin={apiOrigin}>
    <div class="registry-service-state" data-package-state data-state="loading" role="status" aria-live="polite">
      <span class="registry-service-dot" aria-hidden="true"></span>
      <span data-package-state-copy data-i18n="registry.package.loading">{t.registry.package.loading}</span>
    </div>

    <div class="registry-empty" data-package-error hidden>
      <h2 data-i18n="registry.package.loadFailedTitle">{t.registry.package.loadFailedTitle}</h2>
      <p data-package-error-copy>{t.registry.package.loadFailedBody}</p>
      <a class="registry-button" href="/registry" data-i18n="registry.package.backToRegistry">{t.registry.package.backToRegistry}</a>
    </div>

    <article class="registry-pkg" data-package-content hidden>
      <header class="registry-pkg-header">
        <span class="registry-pkg-mark" aria-hidden="true"></span>
        <div class="registry-pkg-titles">
          <h1 data-package-coordinate></h1>
          <p class="registry-pkg-meta" data-package-meta></p>
          <p class="registry-pkg-desc" data-package-description></p>
        </div>
        <span class="registry-status" data-package-status></span>
      </header>

      <div class="registry-pkg-body">
        <div class="registry-pkg-main">
          <section class="registry-panel registry-section-block" aria-labelledby="live-versions-title">
            <p class="registry-label" data-i18n="registry.package.versionsLabel">{t.registry.package.versionsLabel}</p>
            <h2 id="live-versions-title" data-i18n="registry.package.versionsTitle">{t.registry.package.versionsTitle}</h2>
            <div class="registry-table-wrap registry-table-block">
              <table class="registry-table">
                <thead>
                  <tr>
                    <th data-i18n="registry.package.thVersion">{t.registry.package.thVersion}</th>
                    <th data-i18n="registry.package.thEdition">{t.registry.package.thEdition}</th>
                    <th data-i18n="registry.package.thSourceHash">{t.registry.package.thSourceHash}</th>
                    <th data-i18n="registry.package.thProfileHash">{t.registry.package.thProfileHash}</th>
                    <th data-i18n="registry.package.thStatus">{t.registry.package.thStatus}</th>
                  </tr>
                </thead>
                <tbody data-package-versions></tbody>
              </table>
            </div>
          </section>

          <section class="registry-panel registry-section-block" aria-labelledby="live-evidence-title">
            <p class="registry-label" data-i18n="registry.package.evidenceLabel">{t.registry.package.evidenceLabel}</p>
            <h2 id="live-evidence-title" data-i18n="registry.package.evidenceTitle">{t.registry.package.evidenceTitle}</h2>
            <div class="registry-evidence-list" data-package-evidence></div>
          </section>
        </div>

        <aside class="registry-pkg-sidebar">
          <div class="registry-side-card">
            <h3 data-i18n="registry.package.installTitle">{t.registry.package.installTitle}</h3>
            <p data-i18n="registry.package.installBody">{t.registry.package.installBody}</p>
            <div class="registry-command-line">
              <code data-package-install></code>
              <button class="registry-copy" type="button" data-package-install-copy data-copy-text="" data-i18n="registry.copy">{t.registry.copy}</button>
            </div>
          </div>
          <div class="registry-side-card">
            <h3 data-i18n="registry.package.verifyTitle">{t.registry.package.verifyTitle}</h3>
            <p data-i18n="registry.package.verifyBody">{t.registry.package.verifyBody}</p>
            <div class="registry-command-line">
              <code data-package-verify></code>
              <button class="registry-copy" type="button" data-package-verify-copy data-copy-text="" data-i18n="registry.copy">{t.registry.copy}</button>
            </div>
          </div>
          <div class="registry-side-card">
            <h3 data-i18n="registry.package.linksTitle">{t.registry.package.linksTitle}</h3>
            <p><a data-package-repository target="_blank" rel="noopener noreferrer" hidden data-i18n="registry.package.linkRepository">{t.registry.package.linkRepository}</a></p>
            <p><a data-package-json target="_blank" rel="noopener noreferrer" data-i18n="registry.package.linkRegistryJson">{t.registry.package.linkRegistryJson}</a></p>
            <p><a data-package-snapshot target="_blank" rel="noopener noreferrer" hidden data-i18n="registry.package.linkSourceSnapshot">{t.registry.package.linkSourceSnapshot}</a></p>
          </div>
        </aside>
      </div>
    </article>
  </section>

  <script>
    (() => {
      const prior = (window as any).__cellscriptLivePackageAbort as AbortController | undefined;
      prior?.abort();
      const controller = new AbortController();
      (window as any).__cellscriptLivePackageAbort = controller;
      const { signal } = controller;
      document.addEventListener("astro:before-swap", () => controller.abort(), { once: true, signal });

      const app = document.querySelector<HTMLElement>("[data-live-package]");
      if (!app) return;
      const state = app.querySelector<HTMLElement>("[data-package-state]");
      const stateCopy = app.querySelector<HTMLElement>("[data-package-state-copy]");
      const error = app.querySelector<HTMLElement>("[data-package-error]");
      const errorCopy = app.querySelector<HTMLElement>("[data-package-error-copy]");
      const content = app.querySelector<HTMLElement>("[data-package-content]");
      const params = new URLSearchParams(window.location.search);
      const namespace = params.get("namespace")?.trim() ?? "";
      const name = params.get("name")?.trim() ?? "";
      const apiOrigin = app.dataset.apiOrigin ?? "https://api.registry.cellscript.dev";

      const messages = () => (window as any).__CELLSCRIPT_I18N__ as Record<string, any>;
      const locale = () => document.documentElement.dataset.locale === "zh" ? "zh" : "en";
      const message = (path: string) => path.split(".").reduce((value: any, key) => value?.[key], messages()?.[locale()]);
      const shortHash = (value: unknown) => {
        if (typeof value !== "string" || !value) return "—";
        const prefix = value.startsWith("0x") ? "0x" : "";
        const clean = prefix ? value.slice(2) : value;
        return clean.length > 24 ? `${prefix}${clean.slice(0, 12)}…${clean.slice(-12)}` : value;
      };
      const text = (selector: string, value: unknown) => {
        const element = app.querySelector<HTMLElement>(selector);
        if (element) element.textContent = typeof value === "string" ? value : String(value ?? "");
      };

      const showError = (copyKey: string) => {
        if (state) state.hidden = true;
        if (content) content.hidden = true;
        if (error) error.hidden = false;
        if (errorCopy) errorCopy.textContent = message(copyKey) || message("registry.package.loadFailedBody") || "Package could not be loaded.";
      };

      const appendCell = (row: HTMLTableRowElement, value: unknown, code = false) => {
        const cell = document.createElement("td");
        const child = document.createElement(code ? "code" : "span");
        child.textContent = typeof value === "string" ? value : String(value ?? "—");
        cell.append(child);
        row.append(cell);
      };

      const render = (pkg: any) => {
        const coordinate = `${pkg.namespace}/${pkg.name}`;
        const versions = Array.isArray(pkg.versions) ? pkg.versions : [];
        const latest = versions[0];
        text("[data-package-coordinate]", coordinate);
        text("[data-package-meta]", `${message("registry.manage.version") || "Version"} ${pkg.latest_version || "—"} · Edition ${latest?.edition || "2026"}`);
        text("[data-package-description]", pkg.description || message("registry.browse.noDescription"));
        text("[data-package-status]", pkg.status || latest?.status || "source_published");

        const versionsBody = app.querySelector<HTMLTableSectionElement>("[data-package-versions]");
        versionsBody?.replaceChildren();
        for (const version of versions) {
          const row = document.createElement("tr");
          appendCell(row, version.version);
          appendCell(row, version.edition || "2026");
          appendCell(row, shortHash(version.source_hash), true);
          appendCell(row, shortHash(version.compatibility_profile_hash), true);
          appendCell(row, version.status);
          versionsBody?.append(row);
        }

        const evidenceList = app.querySelector<HTMLElement>("[data-package-evidence]");
        evidenceList?.replaceChildren();
        const evidence = versions.flatMap((version: any) => Array.isArray(version.evidence) ? version.evidence.map((item: any) => ({ ...item, version: version.version })) : []);
        if (evidence.length === 0) {
          const emptyEvidence = document.createElement("p");
          emptyEvidence.className = "registry-body-copy";
          emptyEvidence.textContent = message("registry.package.noEvidence") || "No promotion evidence is recorded.";
          evidenceList?.append(emptyEvidence);
        } else {
          for (const item of evidence) {
            const card = document.createElement("div");
            card.className = "registry-evidence-card";
            const title = document.createElement("strong");
            title.textContent = `${item.kind} · ${item.version}`;
            const hash = document.createElement("code");
            hash.textContent = shortHash(item.evidence_hash);
            const actor = document.createElement("span");
            actor.textContent = item.admin_actor || item.evidence?.producer || "registry";
            card.append(title, hash, actor);
            evidenceList?.append(card);
          }
        }

        const install = `cellc install ${coordinate}@${pkg.latest_version}`;
        const verify = `cellc registry verify --live --json ${coordinate}`;
        text("[data-package-install]", install);
        text("[data-package-verify]", verify);
        app.querySelector("[data-package-install-copy]")?.setAttribute("data-copy-text", install);
        app.querySelector("[data-package-verify-copy]")?.setAttribute("data-copy-text", verify);
        const repository = app.querySelector<HTMLAnchorElement>("[data-package-repository]");
        if (repository && typeof pkg.repository === "string" && /^https:\/\//.test(pkg.repository)) {
          repository.href = pkg.repository;
          repository.hidden = false;
        }
        const latestVersion = encodeURIComponent(pkg.latest_version || latest?.version || "");
        const jsonLink = app.querySelector<HTMLAnchorElement>("[data-package-json]");
        if (jsonLink) jsonLink.href = `https://registry.cellscript.dev/packages/${encodeURIComponent(namespace)}/${encodeURIComponent(name)}/versions/${latestVersion}.json`;
        const snapshotLink = app.querySelector<HTMLAnchorElement>("[data-package-snapshot]");
        if (snapshotLink && typeof latest?.source_snapshot?.url === "string" && /^https:\/\//.test(latest.source_snapshot.url)) {
          snapshotLink.href = latest.source_snapshot.url;
          snapshotLink.hidden = false;
        }
        if (state) state.hidden = true;
        if (error) error.hidden = true;
        if (content) content.hidden = false;
      };

      if (!/^[a-z0-9][a-z0-9_-]{0,63}$/.test(namespace) || !/^[a-z0-9][a-z0-9_-]{0,63}$/.test(name)) {
        showError("registry.package.invalidCoordinate");
        return;
      }
      if (stateCopy) stateCopy.textContent = message("registry.package.loading") || "Loading package from the public registry…";
      fetch(`${apiOrigin}/v1/packages/${encodeURIComponent(namespace)}/${encodeURIComponent(name)}`, { headers: { accept: "application/json" }, signal })
        .then(async (response) => {
          if (response.status === 404) throw new Error("not_found");
          if (!response.ok) throw new Error("unavailable");
          const payload = await response.json();
          if (payload?.schema !== "cellscript-public-registry-package-v1") throw new Error("unsupported_schema");
          render(payload);
        })
        .catch((cause) => {
          if (cause?.name === "AbortError") return;
          showError(cause?.message === "not_found" ? "registry.package.notFound" : "registry.package.loadFailedBody");
        });
    })();
  </script>
</RegistryLayout>
