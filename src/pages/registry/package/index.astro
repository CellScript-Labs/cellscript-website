---
import RegistryPackageDetail from "../../../components/RegistryPackageDetail.astro";
import RegistryLayout from "../../../layouts/RegistryLayout.astro";
import { defaultLocale, translations } from "../../../i18n/translations";

const t = translations[defaultLocale];
const apiOrigin = (import.meta.env.PUBLIC_REGISTRY_API_ORIGIN || "https://api.registry.cellscript.dev").replace(/\/$/, "");
---

<RegistryLayout
  title="CellScript Registry: Package"
  description={t.registry.package.liveDescription}
  active="package"
  showHeader={false}
>
  <RegistryPackageDetail apiOrigin={apiOrigin} />
</RegistryLayout>
