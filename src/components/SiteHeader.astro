---
import { defaultLocale, translations } from "../i18n/translations";
import { links } from "../data/site";
import BrandMark from "./BrandMark.astro";
import bookOpenIcon from "@phosphor-icons/core/regular/book-open.svg?raw";
import arrowSquareOutIcon from "@phosphor-icons/core/regular/arrow-square-out.svg?raw";
import circleHalfIcon from "@phosphor-icons/core/regular/circle-half.svg?raw";
import githubIcon from "@phosphor-icons/core/regular/github-logo.svg?raw";
import listIcon from "@phosphor-icons/core/regular/list.svg?raw";
import packageIcon from "@phosphor-icons/core/regular/package.svg?raw";
import terminalIcon from "@phosphor-icons/core/regular/terminal-window.svg?raw";
import xIcon from "@phosphor-icons/core/regular/x.svg?raw";

interface Props {
  page?: "home" | "docs" | "playground" | "registry";
}

const { page = "home" } = Astro.props;
const t = translations[defaultLocale];
---

<header class="site-header landing-header">
  <nav class="nav" aria-label={t.nav.primary}>
    <a class="brand" href="/" aria-label={t.nav.home} aria-current={page === "home" ? "page" : undefined}>
      <BrandMark />
      <span>CellScript</span>
    </a>
    <div class="nav-primary" aria-label={t.nav.primary}>
      <a class:list={["nav-link", page === "docs" && "active"]} href={links.docs} aria-label={t.nav.docs} data-i18n-aria-label="nav.docs" aria-current={page === "docs" ? "page" : undefined}>
        <span data-i18n="nav.docs">{t.nav.docs}</span>
      </a>
      <a class:list={["nav-link", page === "playground" && "active"]} href="/playground" aria-label={t.nav.playground} data-i18n-aria-label="nav.playground" aria-current={page === "playground" ? "page" : undefined}>
        <span data-i18n="nav.playground">{t.nav.playground}</span>
      </a>
      <a class:list={["nav-link", page === "registry" && "active"]} href="/registry" aria-label={t.nav.registryBrowse} data-i18n-aria-label="nav.registryBrowse" aria-current={page === "registry" ? "page" : undefined}>
        <span data-i18n="nav.registryBrowse">{t.nav.registryBrowse}</span>
      </a>
    </div>
    <div class="nav-utilities">
      <a class="nav-utility nav-source" href={links.source} target="_blank" rel="noopener noreferrer" aria-label={t.nav.source} data-i18n-aria-label="nav.source">
        <span class="nav-icon" aria-hidden="true" set:html={githubIcon}></span>
        <span class="nav-tooltip" aria-hidden="true" data-i18n="nav.source">{t.nav.source}</span>
      </a>
      <button class="language-toggle" type="button" data-language-toggle aria-label={t.language.aria}>
        <span data-language-label>{t.language.switchTo}</span>
        <span class="language-short" data-i18n="language.shortSwitch">{t.language.shortSwitch}</span>
      </button>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label={t.theme.switchToDark} aria-pressed="false">
        <span class="nav-icon" aria-hidden="true" set:html={circleHalfIcon}></span>
      </button>
      <button
        class="nav-menu-toggle"
        type="button"
        data-menu-toggle
        aria-label={t.nav.openMenu}
        data-i18n-aria-label="nav.openMenu"
        aria-controls="site-navigation-drawer"
        aria-expanded="false"
      >
        <span class="nav-menu-open-icon nav-icon" aria-hidden="true" set:html={listIcon}></span>
        <span class="nav-menu-close-icon nav-icon" aria-hidden="true" set:html={xIcon}></span>
      </button>
    </div>
  </nav>

  <div class="nav-drawer-backdrop" data-nav-drawer-backdrop hidden>
    <section
      class="nav-drawer"
      id="site-navigation-drawer"
      data-nav-drawer
      role="dialog"
      aria-modal="true"
      aria-label={t.nav.primary}
      tabindex="-1"
    >
      <div class="nav-drawer-head">
        <span data-i18n="nav.navigate">{t.nav.navigate}</span>
        <button class="nav-drawer-close" type="button" data-menu-close aria-label={t.nav.closeMenu} data-i18n-aria-label="nav.closeMenu">
          <span class="nav-icon" aria-hidden="true" set:html={xIcon}></span>
        </button>
      </div>
      <nav class="nav-drawer-links" aria-label={t.nav.primary}>
        <a class:list={["nav-drawer-link", page === "home" && "active"]} href="/" aria-current={page === "home" ? "page" : undefined}>
          <span class="nav-icon nav-drawer-brand-icon" aria-hidden="true"><BrandMark /></span>
          <span data-i18n="nav.overview">{t.nav.overview}</span>
        </a>
        <a class:list={["nav-drawer-link", page === "docs" && "active"]} href={links.docs} aria-current={page === "docs" ? "page" : undefined}>
          <span class="nav-icon" aria-hidden="true" set:html={bookOpenIcon}></span>
          <span data-i18n="nav.docs">{t.nav.docs}</span>
        </a>
        <a class:list={["nav-drawer-link", page === "playground" && "active"]} href="/playground" aria-current={page === "playground" ? "page" : undefined}>
          <span class="nav-icon" aria-hidden="true" set:html={terminalIcon}></span>
          <span data-i18n="nav.playground">{t.nav.playground}</span>
        </a>
        <a class:list={["nav-drawer-link", page === "registry" && "active"]} href="/registry" aria-current={page === "registry" ? "page" : undefined}>
          <span class="nav-icon" aria-hidden="true" set:html={packageIcon}></span>
          <span data-i18n="nav.registryBrowse">{t.nav.registryBrowse}</span>
        </a>
        <a class="nav-drawer-link" href={links.source} target="_blank" rel="noopener noreferrer">
          <span class="nav-icon" aria-hidden="true" set:html={githubIcon}></span>
          <span data-i18n="nav.source">{t.nav.source}</span>
          <span class="nav-external-mark nav-icon" aria-hidden="true" set:html={arrowSquareOutIcon}></span>
        </a>
      </nav>
      <div class="nav-drawer-preferences">
        <span class="nav-drawer-section-label" data-i18n="nav.preferences">{t.nav.preferences}</span>
        <button type="button" data-language-toggle aria-label={t.language.aria}>
          <span data-i18n="language.label">{t.language.label}</span>
          <strong data-language-label>{t.language.switchTo}</strong>
        </button>
        <button type="button" data-theme-toggle aria-label={t.theme.switchToDark} aria-pressed="false">
          <span data-i18n="theme.appearance">{t.theme.appearance}</span>
          <strong data-theme-current>{t.theme.light}</strong>
        </button>
      </div>
    </section>
  </div>
</header>

<script is:inline define:vars={{ i18n: translations, initialLocale: defaultLocale }}>
  (() => {
    window.__CELLSCRIPT_I18N__ = window.__CELLSCRIPT_I18N__ || i18n;
    window.__CELLSCRIPT_DEFAULT_LOCALE__ = window.__CELLSCRIPT_DEFAULT_LOCALE__ || initialLocale;

    const getMessages = () => window.__CELLSCRIPT_I18N__ || i18n;
    const readLocale = () => document.documentElement.dataset.locale === "zh" ? "zh" : "en";
    const readTheme = () => document.documentElement.dataset.theme === "dark" ? "dark" : "light";
    const readStoredTheme = () => {
      try {
        const storedTheme = localStorage.getItem("cellscript-theme");
        return storedTheme === "light" || storedTheme === "dark" ? storedTheme : null;
      } catch {
        return null;
      }
    };
    const readStoredLocale = () => {
      try {
        return localStorage.getItem("cellscript-locale") === "zh" ? "zh" : "en";
      } catch {
        return null;
      }
    };
    const getMessage = (path, locale = readLocale()) =>
      path.split(".").reduce((value, segment) => value == null ? value : value[segment], getMessages()?.[locale]);

    const syncThemeToggles = () => {
      const theme = readTheme();
      const switchKey = theme === "light" ? "theme.switchToDark" : "theme.switchToLight";
      document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
        button.setAttribute("aria-pressed", String(theme === "dark"));
        button.setAttribute("aria-label", getMessage(switchKey) || "");
      });
      document.querySelectorAll("[data-theme-current]").forEach((label) => {
        label.textContent = getMessage(theme === "light" ? "theme.light" : "theme.dark") || "";
      });
    };

    const syncLanguageToggles = () => {
      const locale = readLocale();
      document.querySelectorAll("[data-language-toggle]").forEach((button) => {
        button.setAttribute("aria-label", getMessage("language.aria", locale) || "");
      });
      document.querySelectorAll("[data-language-label]").forEach((label) => {
        label.textContent = getMessage("language.switchTo", locale) || "";
      });
      document.querySelectorAll(".language-short").forEach((label) => {
        label.textContent = getMessage("language.shortSwitch", locale) || "";
      });
    };

    const syncLocalizedStrings = (locale = readLocale()) => {
      document.querySelectorAll("[data-i18n]").forEach((element) => {
        const value = getMessage(element.dataset.i18n || "", locale);
        if (typeof value === "string") element.textContent = value;
      });
      document.querySelectorAll("[data-i18n-aria-label]").forEach((element) => {
        const value = getMessage(element.dataset.i18nAriaLabel || "", locale);
        if (typeof value === "string") element.setAttribute("aria-label", value);
      });
      document.querySelectorAll("[data-i18n-placeholder]").forEach((element) => {
        const value = getMessage(element.dataset.i18nPlaceholder || "", locale);
        if (typeof value === "string") element.setAttribute("placeholder", value);
      });
      syncLanguageToggles();
      syncThemeToggles();
    };

    const setLocale = (locale) => {
      const nextLocale = locale === "zh" ? "zh" : "en";
      document.documentElement.dataset.locale = nextLocale;
      document.documentElement.lang = nextLocale;
      try {
        localStorage.setItem("cellscript-locale", nextLocale);
      } catch {
        /* Locale switching still works without storage. */
      }
      syncLocalizedStrings(nextLocale);
      window.dispatchEvent(new CustomEvent("cellscript:locale-change"));
    };

    const setTheme = (theme) => {
      const nextTheme = theme === "dark" ? "dark" : "light";
      document.documentElement.dataset.theme = nextTheme;
      try {
        localStorage.setItem("cellscript-theme", nextTheme);
      } catch {
        /* Theme switching still works without storage. */
      }
      syncThemeToggles();
      window.dispatchEvent(new CustomEvent("cellscript:theme-change", { detail: { theme: nextTheme } }));
    };

    const syncTopbar = () => {
      const storedTheme = readStoredTheme();
      const storedLocale = readStoredLocale();
      if (storedTheme) document.documentElement.dataset.theme = storedTheme;
      if (storedLocale) {
        document.documentElement.dataset.locale = storedLocale;
        document.documentElement.lang = storedLocale;
      }
      syncLocalizedStrings(readLocale());
      syncHeaderScroll();
    };

    const drawerElements = () => ({
      backdrop: document.querySelector("[data-nav-drawer-backdrop]"),
      drawer: document.querySelector("[data-nav-drawer]"),
      toggle: document.querySelector("[data-menu-toggle]"),
    });

    const closeDrawer = ({ restoreFocus = false, immediate = false } = {}) => {
      const { backdrop, drawer, toggle } = drawerElements();
      if (!backdrop || backdrop.hidden) return;
      if (window.__cellscriptDrawerCloseTimer) window.clearTimeout(window.__cellscriptDrawerCloseTimer);
      drawer?.removeAttribute("data-open");
      backdrop.removeAttribute("data-open");
      toggle?.setAttribute("aria-expanded", "false");
      document.body.removeAttribute("data-menu-open");
      const finish = () => {
        backdrop.hidden = true;
        if (restoreFocus && toggle instanceof HTMLElement) toggle.focus();
      };
      if (immediate || window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) finish();
      else window.__cellscriptDrawerCloseTimer = window.setTimeout(finish, 180);
    };

    const openDrawer = () => {
      const { backdrop, drawer, toggle } = drawerElements();
      if (!backdrop || !drawer || !toggle) return;
      if (window.__cellscriptDrawerCloseTimer) window.clearTimeout(window.__cellscriptDrawerCloseTimer);
      backdrop.hidden = false;
      document.body.dataset.menuOpen = "true";
      toggle.setAttribute("aria-expanded", "true");
      window.requestAnimationFrame(() => {
        backdrop.setAttribute("data-open", "true");
        drawer.setAttribute("data-open", "true");
        drawer.querySelector("a, button")?.focus();
      });
    };

    const syncHeaderScroll = () => {
      const header = document.querySelector(".site-header");
      if (header) header.toggleAttribute("data-scrolled", window.scrollY > 12);
    };

    if (!window.__cellscriptTopbarDelegationBound) {
      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        const menuButton = event.target.closest("[data-menu-toggle]");
        if (menuButton) {
          event.preventDefault();
          const { backdrop } = drawerElements();
          if (backdrop?.hidden) openDrawer();
          else closeDrawer({ restoreFocus: true });
          return;
        }
        if (event.target.closest("[data-menu-close]")) {
          event.preventDefault();
          closeDrawer({ restoreFocus: true });
          return;
        }
        const backdrop = event.target.closest("[data-nav-drawer-backdrop]");
        if (backdrop && event.target === backdrop) {
          closeDrawer({ restoreFocus: true });
          return;
        }
        if (event.target.closest("[data-nav-drawer] a")) closeDrawer({ immediate: true });
        const themeButton = event.target.closest("[data-theme-toggle]");
        if (themeButton) {
          event.preventDefault();
          setTheme(readTheme() === "light" ? "dark" : "light");
          return;
        }
        const languageButton = event.target.closest("[data-language-toggle]");
        if (languageButton) {
          event.preventDefault();
          setLocale(readLocale() === "en" ? "zh" : "en");
        }
      });
      document.addEventListener("keydown", (event) => {
        const { backdrop, drawer } = drawerElements();
        if (!backdrop || backdrop.hidden || !drawer) return;
        if (event.key === "Escape") {
          event.preventDefault();
          closeDrawer({ restoreFocus: true });
          return;
        }
        if (event.key !== "Tab") return;
        const focusable = [...drawer.querySelectorAll("a[href], button:not([disabled]), [tabindex]:not([tabindex='-1'])")]
          .filter((element) => element instanceof HTMLElement && !element.hidden);
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
      document.addEventListener("astro:before-swap", (event) => {
        closeDrawer({ immediate: true });
        const nextRoot = event.newDocument?.documentElement;
        if (!nextRoot) return;
        const theme = readTheme();
        const locale = readLocale();
        nextRoot.dataset.theme = theme;
        nextRoot.dataset.locale = locale;
        nextRoot.lang = locale;
      });
      document.addEventListener("astro:page-load", syncTopbar);
      window.addEventListener("storage", (event) => {
        if (event.key === "cellscript-theme" && (event.newValue === "light" || event.newValue === "dark")) {
          document.documentElement.dataset.theme = event.newValue;
        }
        if (event.key === "cellscript-locale") {
          const locale = event.newValue === "zh" ? "zh" : "en";
          document.documentElement.dataset.locale = locale;
          document.documentElement.lang = locale;
        }
        syncLocalizedStrings(readLocale());
      });
      window.addEventListener("scroll", syncHeaderScroll, { passive: true });
      window.matchMedia?.("(min-width: 841px)").addEventListener?.("change", (event) => {
        if (event.matches) closeDrawer({ immediate: true });
      });
      window.__cellscriptTopbarDelegationBound = true;
    }

    syncTopbar();
  })();
</script>
