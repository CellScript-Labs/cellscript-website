---
import "../styles/global.css";
import "../styles/registry.css";
import SiteHeader from "../components/SiteHeader.astro";
import SitePreferencesBootstrap from "../components/SitePreferencesBootstrap.astro";
import { ClientRouter } from "astro:transitions";
import { defaultLocale, translations } from "../i18n/translations";
import { registrySections } from "../lib/registry";
import { isTestnetSandbox, registryRuntime } from "../lib/registry-runtime";
import bracketsCurlyIcon from "@phosphor-icons/core/regular/brackets-curly.svg?raw";
import magnifyingGlassIcon from "@phosphor-icons/core/regular/magnifying-glass.svg?raw";
import terminalWindowIcon from "@phosphor-icons/core/regular/terminal-window.svg?raw";
import uploadSimpleIcon from "@phosphor-icons/core/regular/upload-simple.svg?raw";
import arrowUpRightIcon from "@phosphor-icons/core/regular/arrow-up-right.svg?raw";

interface Props {
  title: string;
  description: string;
  // Optional i18n keys (under the `registry.*` namespace) for the page
  // heading and description, so the layout can re-render them on locale
  // change. Omit for pages whose heading is a dynamic identifier (e.g. a
  // package coordinate) that should not be localized.
  eyebrowKey?: string;
  headingKey?: string;
  descriptionKey?: string;
  titleKey?: string;
  active: "search" | "submit" | "interface" | "api" | "manage" | "package";
  compactHeader?: boolean;
  showSubmitCta?: boolean;
  showHeader?: boolean;
  showTabs?: boolean;
}

const {
  title,
  description,
  eyebrowKey,
  headingKey,
  descriptionKey,
  titleKey,
  active,
  compactHeader = false,
  showSubmitCta = true,
  showHeader = true,
  showTabs = true,
} = Astro.props;
const locale = defaultLocale;
const t = translations[locale];

// Resolve the SSR heading/description from the i18n table so the
// initial paint matches the default locale (runtime applyLocale keeps
// them in sync afterwards). Falls back to the passed props.
const resolveKey = (key: string | undefined): string | undefined => {
  if (!key) return undefined;
  const parts = key.split(".");
  let cur: any = t;
  for (const p of parts) cur = cur?.[p];
  return typeof cur === "string" ? cur : undefined;
};
const headingText = resolveKey(headingKey) ?? title.replace("CellScript Registry: ", "");
const descriptionText = resolveKey(descriptionKey) ?? description;
const eyebrowText = resolveKey(eyebrowKey);
const titleSuffix = headingKey ? undefined : title.split(": ").slice(1).join(": ") || undefined;
const headerIcons: Partial<Record<Props["active"], string>> = {
  search: magnifyingGlassIcon,
  submit: uploadSimpleIcon,
  interface: bracketsCurlyIcon,
  api: terminalWindowIcon,
};
const headerIcon = headerIcons[active];
const activeHref =
  active === "submit"
    ? "/registry/submit"
    : active === "interface"
      ? "/registry/LS-IDL"
      : active === "api"
        ? "/registry/api"
        : "/registry";
---

<!doctype html>
<html lang={locale} data-theme="light" data-locale={locale} data-registry-environment={registryRuntime.environment} data-registry-network={registryRuntime.network} data-registry-title-key={titleKey} data-registry-title-suffix={titleSuffix}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    {isTestnetSandbox && <meta name="robots" content="noindex,nofollow,noarchive" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}cellscript-logo.png`} />
    <link rel="icon" type="image/png" media="(prefers-color-scheme: light)" href={`${import.meta.env.BASE_URL}cellscript-logo-light.png`} />
    <link rel="icon" type="image/png" media="(prefers-color-scheme: dark)" href={`${import.meta.env.BASE_URL}cellscript-logo-dark.png`} />
    <title>{title}</title>
    <SitePreferencesBootstrap />
    <script is:inline data-astro-rerun>
      (() => {
        const root = document.documentElement;
        if (root.dataset.locale === "zh") root.dataset.registryLocalePending = "true";
        else delete root.dataset.registryLocalePending;
      })();
    </script>
    <style is:inline>html[data-registry-locale-pending="true"] body { visibility: hidden; }</style>
    <ClientRouter />
  </head>
  <body class="registry-body">
    <a class="skip-link" href="#registry-main" data-i18n="a11y.skipToContent">{t.a11y.skipToContent}</a>
    <SiteHeader page="registry" />
    <main id="registry-main" class:list={["registry-app", showHeader && "registry-app-framed"]}>
      <section class:list={["registry-hero", !showHeader && "registry-hero-no-header", !showTabs && "registry-hero-no-tabs"]} data-registry-hero>
        <div class:list={["registry-shell-bar", !showHeader && "registry-shell-bar-context-only"]}>
          {showHeader && <header class:list={["registry-topbar", compactHeader && "registry-topbar-compact"]} transition:name="registry-header" data-registry-section={active} aria-label={t.registry.appLabel} data-i18n-aria-label="registry.appLabel">
            <div class="registry-topbar-copy">
              {eyebrowText && <p class="registry-topbar-kicker">
                {headerIcon && <span class="registry-topbar-kicker-icon" aria-hidden="true" set:html={headerIcon}></span>}
                <span data-i18n={eyebrowKey}>{eyebrowText}</span>
              </p>}
              <h1 data-registry-heading data-registry-heading-key={headingKey}>{headingText}</h1>
              <p data-registry-description data-registry-description-key={descriptionKey}>{descriptionText}</p>
            </div>
            {showSubmitCta && <a class="registry-button primary registry-topbar-cta" href="/registry/submit" data-registry-topbar-cta data-i18n="registry.submitPackage">{t.registry.submitPackage}</a>}
          </header>}
          <aside class:list={["registry-environment-bar", "registry-network-card", isTestnetSandbox && "is-testnet"]} transition:persist="registry-environment" aria-label={isTestnetSandbox ? t.registry.sandboxTitle : t.registry.productionTitle}>
            <p class="registry-network-label" data-i18n="registry.currentNetwork">{t.registry.currentNetwork}</p>
            <div class="registry-network-heading">
              <span class="registry-environment-identity">
                <i aria-hidden="true"></i>
                <strong data-i18n={isTestnetSandbox ? "registry.sandboxTitle" : "registry.productionTitle"}>{isTestnetSandbox ? t.registry.sandboxTitle : t.registry.productionTitle}</strong>
              </span>
              <span class="registry-network-code">CKB</span>
            </div>
            <p class="registry-network-body" data-i18n={isTestnetSandbox ? "registry.sandboxBody" : "registry.productionBody"}>{isTestnetSandbox ? t.registry.sandboxBody : t.registry.productionBody}</p>
            <a class="registry-network-switch" href={registryRuntime.alternateOrigin}>
              <span data-i18n={isTestnetSandbox ? "registry.openProduction" : "registry.openSandbox"}>{isTestnetSandbox ? t.registry.openProduction : t.registry.openSandbox}</span>
              <span aria-hidden="true" set:html={arrowUpRightIcon}></span>
            </a>
          </aside>
        </div>

        {showTabs && <nav class="registry-tabs" transition:persist="registry-tabs" aria-label={t.registry.sectionsLabel} data-i18n-aria-label="registry.sectionsLabel">
          {registrySections.map((section) => (
            <a
              href={section.href}
              class:list={[section.href === activeHref && "active"]}
              aria-current={section.href === activeHref ? "page" : undefined}
            >
              <span data-i18n={section.i18nKey}>{section.label}</span>
            </a>
          ))}
        </nav>}
      </section>

      <div class="registry-route" transition:name="registry-route">
        <slot />
      </div>
    </main>

    <!-- Full i18n message table, embedded so the topbar's language
         toggle can swap every registry string live without a reload. -->
    <script is:inline define:vars={{ i18n: translations }}>
      window.__CELLSCRIPT_I18N__ = i18n;
      window.__CELLSCRIPT_DEFAULT_LOCALE__ = "en";
    </script>

    <script>
      // Registry i18n runtime: mirrors the index/playground layer so the
      // topbar language toggle hot-swaps every [data-i18n] string here.
      const i18nMessages = (window as any).__CELLSCRIPT_I18N__ as any;
      const defaultLocaleName = (window as any).__CELLSCRIPT_DEFAULT_LOCALE__ ?? "en";

      const readLocale = () =>
        document.documentElement.dataset.locale === "zh" ? "zh" : defaultLocaleName;

      const getMessage = (path: string, locale = readLocale()) =>
        path.split(".").reduce((value: any, segment: string) => value?.[segment], i18nMessages?.[locale]);

      const applyLocale = (locale: string) => {
        const nextLocale = locale === "zh" ? "zh" : "en";
        document.documentElement.dataset.locale = nextLocale;
        document.documentElement.lang = nextLocale;
        if (!i18nMessages) {
          delete document.documentElement.dataset.registryLocalePending;
          return;
        }
        document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
          const v = getMessage(el.dataset.i18n ?? "", nextLocale);
          if (typeof v === "string") el.textContent = v;
        });
        document.querySelectorAll<HTMLElement>("[data-i18n-aria-label]").forEach((el) => {
          const v = getMessage(el.dataset.i18nAriaLabel ?? "", nextLocale);
          if (typeof v === "string") el.setAttribute("aria-label", v);
        });
        document.querySelectorAll<HTMLElement>("[data-i18n-placeholder]").forEach((el) => {
          const v = getMessage(el.dataset.i18nPlaceholder ?? "", nextLocale);
          if (typeof v === "string") el.setAttribute("placeholder", v);
        });
        // Re-render the dynamic topbar heading/description and <title>
        // from the active page's registry message (passed via dataset).
        const heading = document.querySelector<HTMLElement>("[data-registry-heading]");
        const headingKey = heading?.dataset.registryHeadingKey;
        if (heading && headingKey) heading.textContent = getMessage(headingKey, nextLocale) ?? heading.textContent;
        const desc = document.querySelector<HTMLElement>("[data-registry-description]");
        const descKey = desc?.dataset.registryDescriptionKey;
        if (desc && descKey) desc.textContent = getMessage(descKey, nextLocale) ?? desc.textContent;
        const titleKey = document.documentElement.dataset.registryTitleKey;
        if (titleKey) {
          const pageTitle = getMessage(titleKey, nextLocale);
          const shellTitle = getMessage("registry.shellTitle", nextLocale);
          document.title = pageTitle === shellTitle ? shellTitle : `${pageTitle} · ${shellTitle}`;
        } else if (headingKey) document.title = `${getMessage("registry.eyebrow", nextLocale)}: ${getMessage(headingKey, nextLocale)}`;
        else if (document.documentElement.dataset.registryTitleSuffix) {
          document.title = `${getMessage("registry.eyebrow", nextLocale)}: ${document.documentElement.dataset.registryTitleSuffix}`;
        }
        try {
          localStorage.setItem("cellscript-locale", nextLocale);
        } catch {
          // Locale switching still works even when storage is unavailable.
        }
        delete document.documentElement.dataset.registryLocalePending;
      };

      const reapplyRegistryLocale = () => {
        if (!document.querySelector("#registry-main.registry-app")) return;
        applyLocale(readLocale());
      };

      const normaliseRegistryPath = (pathname: string) => pathname.replace(/\/+$/, "") || "/";
      const syncRegistryTabs = () => {
        const tabs = document.querySelector<HTMLElement>(".registry-tabs");
        if (!tabs) return;
        const currentPath = normaliseRegistryPath(window.location.pathname);
        let activeLink: HTMLAnchorElement | undefined;
        tabs.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
          const targetPath = normaliseRegistryPath(new URL(link.href, window.location.href).pathname);
          const isActive = targetPath === currentPath;
          link.classList.toggle("active", isActive);
          if (isActive) {
            link.setAttribute("aria-current", "page");
            activeLink = link;
          }
          else link.removeAttribute("aria-current");
        });
        if (!activeLink) {
          delete tabs.dataset.indicatorReady;
          return;
        }
        const tabsRect = tabs.getBoundingClientRect();
        const activeRect = activeLink.getBoundingClientRect();
        tabs.style.setProperty("--registry-tab-indicator-x", `${activeRect.left - tabsRect.left + tabs.scrollLeft}px`);
        tabs.style.setProperty("--registry-tab-indicator-width", `${activeRect.width}px`);
        if (!tabs.dataset.indicatorReady) {
          requestAnimationFrame(() => {
            if (tabs.isConnected) tabs.dataset.indicatorReady = "true";
          });
        }
      };

      const syncRegistryShell = () => {
        reapplyRegistryLocale();
        syncRegistryTabs();
      };

      // React to the topbar's locale-change event (it dispatches after
      // updating <html data-locale>) and after Astro swaps page content.
      if (!(window as any).__cellscriptRegistryLayoutLocaleBound) {
        window.addEventListener("cellscript:locale-change", reapplyRegistryLocale);
        window.addEventListener("resize", syncRegistryTabs, { passive: true });
        document.addEventListener("astro:after-swap", syncRegistryShell);
        document.addEventListener("astro:page-load", syncRegistryShell);
        (window as any).__cellscriptRegistryLayoutLocaleBound = true;
      }
      // Apply the stored locale once on load so a refresh honours it.
      syncRegistryShell();
    </script>

    <script is:inline>
      const flashCopyResult = (button, ok) => {
        const i18n = window.__CELLSCRIPT_I18N__;
        const locale = document.documentElement.dataset.locale === "zh" ? "zh" : "en";
        const get = (path) => path.split(".").reduce((v, k) => (v == null ? v : v[k]), i18n == null ? i18n : i18n[locale]);
        const copiedLabel = (button.dataset.copiedLabel || get("registry.copied") || "Copied");
        const failedLabel = (button.dataset.copyFailedLabel || get("registry.copyFailed") || "Copy failed");
        const revertLabel = (button.dataset.revertLabel || get("registry.copy") || "Copy");
        button.classList.add(ok ? "is-copied" : "is-copy-failed");
        const previous = button.dataset.revertLabel ? button.textContent : revertLabel;
        button.dataset.revertLabel = button.dataset.revertLabel || button.textContent;
        button.textContent = ok ? copiedLabel : failedLabel;
        window.setTimeout(() => {
          button.classList.remove("is-copied", "is-copy-failed");
          button.textContent = previous || revertLabel;
        }, 1400);
      };

      const writeClipboard = async (text) => {
        if (!navigator.clipboard?.writeText) {
          return false;
        }

        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          return false;
        }
      };

      if (!window["__cellscriptRegistryCopyDelegationBound"]) {
        document.addEventListener("click", async (event) => {
          const button = event.target instanceof Element ? event.target.closest("[data-copy-text]") : null;
          if (!button) return;
          const text = button.getAttribute("data-copy-text");
          if (!text) return;
          const ok = await writeClipboard(text);
          flashCopyResult(button, ok);
        });
        window["__cellscriptRegistryCopyDelegationBound"] = true;
      }
    </script>
  </body>
</html>
